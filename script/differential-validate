    password   => 'hunter22',
  });
  my $new_secondary_login = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $server{$name}{secondary_handle},
    password   => 'newhunter22',
  });

  my $info_json = $info->json || {};
  my @infos = @{ $info_json->{infos} || [] };
  my $subject_active_json = $subject_active->json || {};
  my $disabled_json = $disabled_info->json || {};
  my $enabled_json  = $enabled_info->json || {};

  $server{$name}{admin_account_management} = {
    get_infos => {
      status           => $info->code // 0,
      returned_count   => scalar @infos,
      first_is_primary => (@infos && (($infos[0]{did} // q()) eq $server{$name}{did})) ? 1 : 0,
    },
    get_info_missing      => normalize_xrpc_error($info_missing),
    send_missing         => normalize_xrpc_error($send_missing),
    update_email_missing => normalize_xrpc_error($update_email_missing),
    delete_missing       => {
      status => $delete_missing->code // 0,
      body   => $delete_missing->body,
    },
    get_subject_active => {
      status             => $subject_active->code // 0,
      subject_is_primary => (($subject_active_json->{subject}{did} // q()) eq $server{$name}{did}) ? 1 : 0,
      subject_type       => $subject_active_json->{subject}{'$type'},
      takedown_applied   => $subject_active_json->{takedown}{applied} ? 1 : 0,
      deactivated_applied => $subject_active_json->{deactivated}{applied} ? 1 : 0,
    },
    get_subject_missing          => normalize_xrpc_error($subject_missing),
    get_subject_missing_blob_did => normalize_xrpc_error($subject_missing_blob_did),
    get_subject_missing_ref      => normalize_xrpc_error($subject_missing_ref),
    disable_admin_codes => normalize_xrpc_error($disable_admin),
    disable_account_invites => {
      status           => $disable_invites->code // 0,
      disabled_status  => $disabled_info->code // 0,
      invites_disabled => $disabled_json->{invitesDisabled} ? 1 : 0,
      invite_note      => $disabled_json->{inviteNote},
    },
    disable_account_invites_missing => {
      status => $disable_invites_missing->code // 0,
      body   => $disable_invites_missing->body,
    },
    enable_account_invites => {
      status           => $enable_invites->code // 0,
      enabled_status   => $enabled_info->code // 0,
      invites_disabled => $enabled_json->{invitesDisabled} ? 1 : 0,
      invite_note      => $enabled_json->{inviteNote},
    },
    enable_account_invites_missing => {
      status => $enable_invites_missing->code // 0,
      body   => $enable_invites_missing->body,
    },
    update_password_short => normalize_xrpc_error($short_password),
    update_password_reset => {
      status     => $reset_password->code // 0,
      old_login  => normalize_xrpc_error($old_secondary_login),
      new_login  => normalize_xrpc_error($new_secondary_login),
    },
    update_password_missing => {
      status => $reset_password_missing->code // 0,
      body   => $reset_password_missing->body,
    },
  };
}

if (!same_hash($server{reference}{admin_account_management}, $server{perlsky}{admin_account_management})) {
  note('reference admin account management: ' . encode_json($server{reference}{admin_account_management}));
  note('perlsky admin account management: ' . encode_json($server{perlsky}{admin_account_management}));
  fail_check('admin account-management semantics match the official reference PDS');
} else {
  pass('admin account-management semantics match the official reference PDS');
}

note('Comparing admin invite-code listing semantics');
for my $name (sort keys %server) {
  my $used_batch = post_json(
    $server{$name}{origin},
    'com.atproto.server.createInviteCodes',
    {
      codeCount => 1,
      useCount  => 2,
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($used_batch->is_success, "$name createInviteCodes succeeds for used-code batch");
  next unless $used_batch->is_success;
  my $used_code = (($used_batch->json || {})->{codes} || [])->[0]{codes}[0];

  sleep 1.1;

  my $unused_batch = post_json(
    $server{$name}{origin},
    'com.atproto.server.createInviteCodes',
    {
      codeCount => 1,
      useCount  => 1,
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($unused_batch->is_success, "$name createInviteCodes succeeds for unused-code batch");
  next unless $unused_batch->is_success;
  my $unused_code = (($unused_batch->json || {})->{codes} || [])->[0]{codes}[0];

  my $invite_first = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle     => $name eq 'reference' ? 'invite-a-ref.test'  : 'invite-a-perl.test',
    email      => "invite-a-$name\@test.com",
    password   => 'hunter22',
    inviteCode => $used_code,
  });
  check($invite_first->is_success, "$name first invite-code account creation succeeds");
  next unless $invite_first->is_success;
  my $invite_first_did = ($invite_first->json || {})->{did};

  sleep 1.1;

  my $invite_second = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle     => $name eq 'reference' ? 'invite-b-ref.test'  : 'invite-b-perl.test',
    email      => "invite-b-$name\@test.com",
    password   => 'hunter22',
    inviteCode => $used_code,
  });
  check($invite_second->is_success, "$name second invite-code account creation succeeds");
  next unless $invite_second->is_success;
  my $invite_second_did = ($invite_second->json || {})->{did};

  my $recent = get_form(
    $server{$name}{origin},
    'com.atproto.admin.getInviteCodes',
    { sort => 'recent', limit => 10 },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($recent->is_success, "$name getInviteCodes recent succeeds");

  my $usage = get_form(
    $server{$name}{origin},
    'com.atproto.admin.getInviteCodes',
    { sort => 'usage', limit => 10 },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($usage->is_success, "$name getInviteCodes usage succeeds");

  my $bad_sort = get_form(
    $server{$name}{origin},
    'com.atproto.admin.getInviteCodes',
    { sort => 'bogus', limit => 10 },
    admin_auth_header($server{$name}{admin_password}),
  );

  my %code_label = (
    ($used_code   // q()) => 'used',
    ($unused_code // q()) => 'unused',
  );
  my %did_label = (
    ($invite_first_did  // q()) => 'first',
    ($invite_second_did // q()) => 'second',
  );
  my $normalize_codes = sub ($rows) {
    return [
      map {
        +{
          label      => $code_label{$_->{code} // q()} // 'unknown',
          available  => $_->{available},
          disabled   => $_->{disabled} ? 1 : 0,
          forAccount => $_->{forAccount},
          createdBy  => $_->{createdBy},
          uses_count => scalar @{ $_->{uses} || [] },
          use_labels => [ map { $did_label{$_->{usedBy} // q()} // 'unknown' } @{ $_->{uses} || [] } ],
        }
      } @$rows
    ];
  };

  $server{$name}{admin_invite_code_listing} = {
    recent => {
      cursor_present => defined(($recent->json || {})->{cursor}) ? 1 : 0,
      codes          => $normalize_codes->(($recent->json || {})->{codes} || []),
    },
    usage => {
      cursor_present => defined(($usage->json || {})->{cursor}) ? 1 : 0,
      codes          => $normalize_codes->(($usage->json || {})->{codes} || []),
    },
    bad_sort => normalize_xrpc_error($bad_sort),
  };
}

if (!same_hash($server{reference}{admin_invite_code_listing}, $server{perlsky}{admin_invite_code_listing})) {
  note('reference admin invite code listing: ' . encode_json($server{reference}{admin_invite_code_listing}));
  note('perlsky admin invite code listing: ' . encode_json($server{perlsky}{admin_invite_code_listing}));
  fail_check('admin invite-code listing semantics match the official reference PDS');
} else {
  pass('admin invite-code listing semantics match the official reference PDS');
}

note('Comparing email and account-delete semantics');
for my $name (sort keys %server) {
  my $flow_handle    = $name eq 'reference' ? 'ef-ref.test'  : 'ef-perl.test';
  my $flow_email     = "emailflow-$name\@test.com";
  my $updated_email  = "updated-$name\@test.com";

  my $flow_create = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => $flow_handle,
    email    => $flow_email,
    password => 'hunter22',
  });
  check($flow_create->is_success, "$name createAccount succeeds for email lifecycle audit");
  next unless $flow_create->is_success;

  my $flow_json = $flow_create->json || {};
  my $flow_did = $flow_json->{did};
  my $flow_access = $flow_json->{accessJwt};

  my $initial_update = post_empty(
    $server{$name}{origin},
    'com.atproto.server.requestEmailUpdate',
    auth_header($flow_access),
  );
  my $request_confirm = post_empty(
    $server{$name}{origin},
    'com.atproto.server.requestEmailConfirmation',
    auth_header($flow_access),
  );
  my $confirm_token = latest_email_token_record($server{$name}, 'confirm', $flow_did);

  my $wrong_confirm = post_json(
    $server{$name}{origin},
    'com.atproto.server.confirmEmail',
    {
      email => "wrong-$name\@test.com",
      token => $confirm_token->{token},
    },
    auth_header($flow_access),
  );
  my $confirm_ok = post_json(
    $server{$name}{origin},
    'com.atproto.server.confirmEmail',
    {
      email => uc $flow_email,
      token => $confirm_token->{token},
    },
    auth_header($flow_access),
  );
  my $session_after_confirm = get_json(
    $server{$name}{origin},
    'com.atproto.server.getSession',
    undef,
    auth_header($flow_access),
  );

  my $confirmed_update = post_empty(
    $server{$name}{origin},
    'com.atproto.server.requestEmailUpdate',
    auth_header($flow_access),
  );
  my $update_token = latest_email_token_record($server{$name}, 'update', $flow_did);
  my $missing_update_token = post_json(
    $server{$name}{origin},
    'com.atproto.server.updateEmail',
    { email => $updated_email },
    auth_header($flow_access),
  );

  expire_email_token_record($server{$name}, 'update', $flow_did);
  my $expired_update = post_json(
    $server{$name}{origin},
    'com.atproto.server.updateEmail',
    {
      email => $updated_email,
      token => $update_token->{token},
    },
    auth_header($flow_access),
  );

  my $renew_update = post_empty(
    $server{$name}{origin},
    'com.atproto.server.requestEmailUpdate',
    auth_header($flow_access),
  );
  my $fresh_update_token = latest_email_token_record($server{$name}, 'update', $flow_did);
  my $update_ok = post_json(
    $server{$name}{origin},
    'com.atproto.server.updateEmail',
    {
      email => $updated_email,
      token => $fresh_update_token->{token},
    },
    auth_header($flow_access),
  );
  my $session_after_update = get_json(
    $server{$name}{origin},
    'com.atproto.server.getSession',
    undef,
    auth_header($flow_access),
  );

  my $request_delete = post_empty(
    $server{$name}{origin},
    'com.atproto.server.requestAccountDelete',
    auth_header($flow_access),
  );
  my $delete_token = latest_email_token_record($server{$name}, 'delete', $flow_did);

  expire_email_token_record($server{$name}, 'delete', $flow_did);
  my $expired_delete = post_json(
    $server{$name}{origin},
    'com.atproto.server.deleteAccount',
    {
      did      => $flow_did,
      password => 'hunter22',
      token    => $delete_token->{token},
    },
  );

  my $renew_delete = post_empty(
    $server{$name}{origin},
    'com.atproto.server.requestAccountDelete',
    auth_header($flow_access),
  );
  my $fresh_delete_token = latest_email_token_record($server{$name}, 'delete', $flow_did);
  my $delete_ok = post_json(
    $server{$name}{origin},
    'com.atproto.server.deleteAccount',
    {
      did      => $flow_did,
      password => 'hunter22',
      token    => $fresh_delete_token->{token},
    },
  );
  my $post_delete_login = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $flow_handle,
    password   => 'hunter22',
  });

  $server{$name}{email_account_management} = {
    confirm => {
      initial_update => {
        status         => $initial_update->code // 0,
        token_required => (($initial_update->json || {})->{tokenRequired} ? 1 : 0),
      },
      request_status      => $request_confirm->code // 0,
      token_present       => $confirm_token && length($confirm_token->{token} // q()) ? 1 : 0,
      wrong_email_error   => {
        status  => $wrong_confirm->code // 0,
        error   => ($wrong_confirm->json || {})->{error},
        message => ($wrong_confirm->json || {})->{message},
      },
      confirm_status      => $confirm_ok->code // 0,
      session_confirmed   => ($session_after_confirm->json || {})->{emailConfirmed} ? 1 : 0,
    },
    update => {
      request_status      => $confirmed_update->code // 0,
      token_required      => (($confirmed_update->json || {})->{tokenRequired} ? 1 : 0),
      token_present       => $update_token && length($update_token->{token} // q()) ? 1 : 0,
      missing_token_error => {
        status  => $missing_update_token->code // 0,
        error   => ($missing_update_token->json || {})->{error},
        message => ($missing_update_token->json || {})->{message},
      },
      expired_token_error => {
        status  => $expired_update->code // 0,
        error   => ($expired_update->json || {})->{error},
        message => ($expired_update->json || {})->{message},
      },
      renew_status        => $renew_update->code // 0,
      fresh_token_present => $fresh_update_token && length($fresh_update_token->{token} // q()) ? 1 : 0,
      update_status       => $update_ok->code // 0,
      session_email_matches => (($session_after_update->json || {})->{email} // q()) eq $updated_email ? 1 : 0,
      session_confirmed   => ($session_after_update->json || {})->{emailConfirmed} ? 1 : 0,
    },
    delete => {
      request_status      => $request_delete->code // 0,
      token_present       => $delete_token && length($delete_token->{token} // q()) ? 1 : 0,
      expired_token_error => {
        status  => $expired_delete->code // 0,
        error   => ($expired_delete->json || {})->{error},
        message => ($expired_delete->json || {})->{message},
      },
      renew_status        => $renew_delete->code // 0,
      fresh_token_present => $fresh_delete_token && length($fresh_delete_token->{token} // q()) ? 1 : 0,
      delete_result       => {
        status  => $delete_ok->code // 0,
        error   => ($delete_ok->json || {})->{error},
        message => ($delete_ok->json || {})->{message},
      },
      post_delete_login   => normalize_xrpc_error($post_delete_login),
    },
  };
}

if (!same_hash($server{reference}{email_account_management}, $server{perlsky}{email_account_management})) {
  note('reference email account management: ' . encode_json($server{reference}{email_account_management}));
  note('perlsky email account management: ' . encode_json($server{perlsky}{email_account_management}));
  fail_check('email and account-delete semantics match the official reference PDS');
} else {
  pass('email and account-delete semantics match the official reference PDS');
}

if ($failed) {
  print "\nReference PDS log:\n";
  print slurp_file($ref_log);
  print "\nperlsky log:\n";
  print slurp_file($perl_log);
  print "\nPLC mock log:\n";
  print slurp_file($plc_log);
  print "\nReference crawler log:\n";
  print slurp_file($reference_crawler_log);
  print "\nperlsky crawler log:\n";
  print slurp_file($perlsky_crawler_log);
  die "\ndifferential validation failed with $failed mismatches\n";
}

note('Differential validation succeeded');
exit 0;
