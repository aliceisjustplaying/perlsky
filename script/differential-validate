note('Comparing future cursor error behavior');
for my $name (sort keys %server) {
  my $frame = first_frame("$server{$name}{origin}/xrpc/com.atproto.sync.subscribeRepos?cursor=999999999999");
  my $header = $frame->{header} || {};
  my $body   = $frame->{body}   || {};
  $server{$name}{future_cursor} = {
    op    => $header->{op},
    error => $body->{error},
  };
}

