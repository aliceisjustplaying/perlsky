my $perlsky_crawler_ready    = File::Spec->catfile($tmp, 'perlsky-crawler.ready.json');

my $plc_log = File::Spec->catfile($tmp, 'plc.log');
my $ref_log = File::Spec->catfile($tmp, 'reference.log');
my $perl_log = File::Spec->catfile($tmp, 'perlsky.log');
my $reference_crawler_log = File::Spec->catfile($tmp, 'reference-crawler.log');
my $perlsky_crawler_log    = File::Spec->catfile($tmp, 'perlsky-crawler.log');

my $plc = spawn_logged(
  'plc-mock',
  ['fnm', 'exec', '--using=20', '--', 'node', File::Spec->catfile($root, 'tools', 'differential', 'plc-mock.cjs')],
  {
    PERLSKY_READY_FILE => $plc_ready,
    PERLSKY_PLC_PORT   => $plc_port,
    PERLSKY_PLC_HOST   => '127.0.0.1',
