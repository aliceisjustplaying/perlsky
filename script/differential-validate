  same_hash($server{reference}{future_cursor}, $server{perlsky}{future_cursor}),
  'subscribeRepos agrees on future cursor errors',
);

note('Comparing deleteSession revocation behavior');
for my $name (sort keys %server) {
  my $session = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $server{$name}{renamed_handle} || $server{$name}{handle},
    password   => 'hunter22',
  });
  check($session->is_success, "$name createSession succeeds before deleteSession");
  next unless $session->is_success;
  my $json = $session->json || {};
  my $delete = post_empty(
    $server{$name}{origin},
    'com.atproto.server.deleteSession',
    auth_header($json->{refreshJwt}),
  );
  my $refresh_after_delete = post_empty(
    $server{$name}{origin},
    'com.atproto.server.refreshSession',
    auth_header($json->{refreshJwt}),
  );
  my $fresh_session = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $server{$name}{renamed_handle} || $server{$name}{handle},
    password   => 'hunter22',
  });
  $server{$name}{delete_session} = {
    delete_ok           => $delete->is_success ? 1 : 0,
    refresh_revoked     => $refresh_after_delete->is_success ? 0 : 1,
    fresh_login_works   => $fresh_session->is_success ? 1 : 0,
  };
}

check(
  same_hash($server{reference}{delete_session}, $server{perlsky}{delete_session}),
  'deleteSession revocation behavior matches the official reference PDS',
);

if ($failed) {
  print "\nReference PDS log:\n";
  print slurp_file($ref_log);
  print "\nperlsky log:\n";
  print slurp_file($perl_log);
  print "\nPLC mock log:\n";
  print slurp_file($plc_log);
  print "\nReference crawler log:\n";
  print slurp_file($reference_crawler_log);
  print "\nperlsky crawler log:\n";
  print slurp_file($perlsky_crawler_log);
  die "\ndifferential validation failed with $failed mismatches\n";
}

note('Differential validation succeeded');
exit 0;
