  'perlsky-crawler',
  ['fnm', 'exec', '--using=20', '--', 'node', File::Spec->catfile($root, 'tools', 'differential', 'crawler-mock.cjs')],
  {
    PERLSKY_READY_FILE   => $perlsky_crawler_ready,
    PERLSKY_CRAWLER_PORT => $perlsky_crawler_port,
    PERLSKY_CRAWLER_HOST => '127.0.0.1',
  },
  $perlsky_crawler_log,
);

my $reference_crawler_info = wait_for_ready_file('reference crawler', $reference_crawler_ready);
wait_for_http_ok('reference crawler', "$reference_crawler_info->{origin}/_health");
pass("started reference crawler mock at $reference_crawler_info->{origin}");

my $perlsky_crawler_info = wait_for_ready_file('perlsky crawler', $perlsky_crawler_ready);
wait_for_http_ok('perlsky crawler', "$perlsky_crawler_info->{origin}/_health");
pass("started perlsky crawler mock at $perlsky_crawler_info->{origin}");

my $reference_data = File::Spec->catdir($tmp, 'reference');
make_path($reference_data);

my $reference = spawn_logged(
  'reference-pds',
  ['fnm', 'exec', '--using=20', '--', 'node', File::Spec->catfile($root, 'tools', 'differential', 'reference-pds-runner.cjs')],
  {
    PERLSKY_READY_FILE                       => $ref_ready,
    PDS_PORT                                 => $reference_port,
    PDS_HOSTNAME                             => 'localhost',
    PDS_DEV_MODE                             => 1,
    PDS_DATA_DIRECTORY                       => File::Spec->catdir($reference_data, 'data'),
    PDS_BLOBSTORE_DISK_LOCATION              => File::Spec->catdir($reference_data, 'blobs'),
    PDS_BLOBSTORE_DISK_TMP_LOCATION          => File::Spec->catdir($reference_data, 'blobs-tmp'),
    PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX => random_hex(32),
    PDS_JWT_SECRET                           => 'reference-jwt-secret',
    PDS_ADMIN_PASSWORD                       => 'reference-admin-secret',
    PDS_INVITE_REQUIRED                      => 0,
    PDS_DID_PLC_URL                          => $plc_info->{origin},
    PDS_CONTACT_EMAIL_ADDRESS                => 'abuse@example.test',
    PDS_CRAWLERS                             => $reference_crawler_info->{origin},
  },
  $ref_log,
);

my $reference_info = wait_for_ready_file('reference pds', $ref_ready);
wait_for_http_ok('reference pds', "$reference_info->{origin}/xrpc/_health");
pass("started official reference PDS at $reference_info->{origin}");

my $perlsky_config = File::Spec->catfile($tmp, 'perlsky.json');
open my $cfg_fh, '>', $perlsky_config or die "unable to write $perlsky_config: $!";
print {$cfg_fh} encode_json({
  base_url              => "http://127.0.0.1:$perl_port",
  hostname              => 'localhost',
  service_handle_domain => 'test',
  service_did_method    => 'did:web',
  account_did_method    => $diff_account_did_method,
  ($diff_account_did_method eq 'did:plc'
    ? (
        plc_url                      => $plc_info->{origin},
        plc_rotation_private_key_hex => ('11' x 32),
      )
    : ()),
  jwt_secret            => 'perlsky-jwt-secret',
  admin_password        => 'perlsky-admin-secret',
  crawlers              => [$perlsky_crawler_info->{origin}],
  data_dir              => File::Spec->catdir($tmp, 'perlsky-data'),
  db_path               => File::Spec->catfile($tmp, 'perlsky.sqlite'),
});
close $cfg_fh;

my $perlsky = spawn_logged(
  'perlsky',
  [$^X, File::Spec->catfile($root, 'script', 'perlsky'), 'daemon', '-l', "http://127.0.0.1:$perl_port"],
  {
    PERLSKY_CONFIG => $perlsky_config,
  },
  $perl_log,
);

wait_for_http_ok('perlsky', "http://127.0.0.1:$perl_port/xrpc/_health");
pass("started perlsky at http://127.0.0.1:$perl_port");

my %server = (
  reference => {
    origin         => $reference_info->{origin},
    handle         => 'alice.test',
    email          => 'alice-ref@test.com',
    admin_password => 'reference-admin-secret',
    crawler_origin => $reference_crawler_info->{origin},
  },
  perlsky => {
    origin         => "http://127.0.0.1:$perl_port",
    handle         => 'alice.test',
    email          => 'alice-perl@test.com',
    admin_password => 'perlsky-admin-secret',
    crawler_origin => $perlsky_crawler_info->{origin},
  },
);

note('Comparing describeServer');
for my $name (sort keys %server) {
  my $res = get_json($server{$name}{origin}, 'com.atproto.server.describeServer');
  check($res->is_success, "$name describeServer succeeds");
  $server{$name}{describe} = $res->json if $res->is_success;
}

check(
  same_hash(
    {
      inviteCodeRequired => $server{reference}{describe}{inviteCodeRequired} ? true : false,
      availableUserDomains => normalized_domains(get_json($server{reference}{origin}, 'com.atproto.server.describeServer')),
    },
    {
      inviteCodeRequired => $server{perlsky}{describe}{inviteCodeRequired} ? true : false,
      availableUserDomains => normalized_domains(get_json($server{perlsky}{origin}, 'com.atproto.server.describeServer')),
    },
  ),
  'describeServer matches on invite requirement and user domains',
);

note('Creating matching accounts');
for my $name (sort keys %server) {
  my $res = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => $server{$name}{handle},
    email    => $server{$name}{email},
    password => 'hunter22',
  });
  check($res->is_success, "$name createAccount succeeds");
  next unless $res->is_success;

  my $json = $res->json;
  $server{$name}{did} = $json->{did};
  $server{$name}{access} = $json->{accessJwt};
  $server{$name}{refresh} = $json->{refreshJwt};
  $server{$name}{create_account} = $json;

  check(($json->{handle} // q()) eq $server{$name}{handle}, "$name createAccount returns normalized handle");
  check(defined $json->{did} && $json->{did} =~ /\Adid:/, "$name createAccount returns a DID");
  check(defined $json->{accessJwt} && length $json->{accessJwt}, "$name createAccount returns an access token");
  check(defined $json->{refreshJwt} && length $json->{refreshJwt}, "$name createAccount returns a refresh token");
  check(($json->{did} // q()) =~ /\Adid:plc:/, "$name createAccount returns a PLC DID")
    if $diff_account_did_method eq 'did:plc';
}

note('Comparing resolveHandle');
for my $name (sort keys %server) {
  my $res = get_form($server{$name}{origin}, 'com.atproto.identity.resolveHandle', { handle => $server{$name}{handle} });
  check($res->is_success, "$name resolveHandle succeeds");
  next unless $res->is_success;
  check(($res->json->{did} // q()) eq $server{$name}{did}, "$name resolveHandle returns the created DID");
}

note('Comparing subscribeRepos bootstrap backfill');
for my $name (sort keys %server) {
  my $frames = frames_until_quiet("$server{$name}{origin}/xrpc/com.atproto.sync.subscribeRepos?cursor=0");
  $server{$name}{bootstrap_firehose} = normalize_bootstrap_frames(
    $frames,
    $server{$name}{did},
    $server{$name}{handle},
  );
  check(@$frames >= 1, "$name subscribeRepos emits bootstrap frames from cursor=0");
}

check(
  same_hash($server{reference}{bootstrap_firehose}, $server{perlsky}{bootstrap_firehose}),
  'subscribeRepos bootstrap backfill matches the official reference PDS semantics',
);

note('Comparing crawler notifications');
for my $name (sort keys %server) {
  my $state = wait_for_crawler_requests("$name crawler", $server{$name}{crawler_origin});
  my $first = $state->{requests}[0]{body} || {};
  $server{$name}{crawler_notice} = {
    saw_request      => (($state->{count} // 0) >= 1) ? 1 : 0,
    hostname_matches => (($first->{hostname} // q()) eq 'localhost') ? 1 : 0,
  };
  check($server{$name}{crawler_notice}{saw_request}, "$name requested a relay crawl");
  check($server{$name}{crawler_notice}{hostname_matches}, "$name requestCrawl uses the configured hostname");
}

check(
  same_hash($server{reference}{crawler_notice}, $server{perlsky}{crawler_notice}),
  'outbound crawler notifications match the official reference PDS semantics',
);

note('Comparing getSession');
for my $name (sort keys %server) {
  my $res = get_json($server{$name}{origin}, 'com.atproto.server.getSession', undef, auth_header($server{$name}{access}));
  check($res->is_success, "$name getSession succeeds");
  next unless $res->is_success;
  my $json = $res->json;
  $server{$name}{session} = $json;
  check(($json->{did} // q()) eq $server{$name}{did}, "$name getSession returns the created DID");
  check(($json->{handle} // q()) eq $server{$name}{handle}, "$name getSession returns the created handle");
}

note('Comparing refreshSession token rotation');
for my $name (sort keys %server) {
  my $res = post_empty(
    $server{$name}{origin},
    'com.atproto.server.refreshSession',
    auth_header($server{$name}{refresh}),
  );
  check($res->is_success, "$name refreshSession succeeds");
  next unless $res->is_success;
  my $json = $res->json || {};
  my $old_access = $server{$name}{access};
  my $old_refresh = $server{$name}{refresh};
  my $old_refresh_claims = jwt_claims($old_refresh);
  $server{$name}{access} = $json->{accessJwt};
  $server{$name}{refresh} = $json->{refreshJwt};
  my $new_refresh_claims = jwt_claims($server{$name}{refresh});

  my $old_access_res = get_json(
    $server{$name}{origin},
    'com.atproto.server.getSession',
    undef,
    auth_header($old_access),
  );
  my $old_refresh_res = post_empty(
    $server{$name}{origin},
    'com.atproto.server.refreshSession',
    auth_header($old_refresh),
  );
  my $new_access_res = get_json(
    $server{$name}{origin},
    'com.atproto.server.getSession',
    undef,
    auth_header($server{$name}{access}),
  );
  my $old_refresh_json = $old_refresh_res->json || {};
  my $reused_refresh_claims = jwt_claims($old_refresh_json->{refreshJwt});

  $server{$name}{refresh_rotation} = {
    has_access_jwt          => length($json->{accessJwt} // q()) ? 1 : 0,
    has_refresh_jwt         => length($json->{refreshJwt} // q()) ? 1 : 0,
    refresh_rotated         => (($new_refresh_claims->{jti} // q()) ne ($old_refresh_claims->{jti} // q())) ? 1 : 0,
    old_access_works        => $old_access_res->is_success ? 1 : 0,
    old_refresh_works       => $old_refresh_res->is_success ? 1 : 0,
    reused_refresh_matches  => $old_refresh_res->is_success
      && (($reused_refresh_claims->{jti} // q()) eq ($new_refresh_claims->{jti} // q()))
      ? 1
      : 0,
    new_access_works        => $new_access_res->is_success ? 1 : 0,
  };
}

check(
  same_hash($server{reference}{refresh_rotation}, $server{perlsky}{refresh_rotation}),
  'refreshSession grace and successor semantics match the official reference PDS',
);

if ($diff_account_did_method eq 'did:plc') {
  note('Comparing PLC identity semantics');
  for my $name (sort keys %server) {
    my $res = get_json(
      $server{$name}{origin},
      'com.atproto.identity.getRecommendedDidCredentials',
      undef,
      auth_header($server{$name}{access}),
    );
    check($res->is_success, "$name getRecommendedDidCredentials succeeds");
    next unless $res->is_success;
    $server{$name}{recommended_did} = normalize_plc_credentials(
      $res->json || {},
      $server{$name}{handle},
      $server{$name}{origin},
    );
  }

  check(
    same_hash($server{reference}{recommended_did}, $server{perlsky}{recommended_did}),
    'getRecommendedDidCredentials matches the official reference PDS semantics',
  );

  note('Comparing PLC signature requests');
  for my $name (sort keys %server) {
    my $res = post_empty(
      $server{$name}{origin},
      'com.atproto.identity.requestPlcOperationSignature',
      auth_header($server{$name}{access}),
    );
    check($res->is_success, "$name requestPlcOperationSignature succeeds");
  }

  note('Comparing PLC handle updates');
  for my $name (sort keys %server) {
    my $new_handle = $name eq 'reference' ? 'alice-renamed-ref.test' : 'alice-renamed-perl.test';
    my $res = post_json(
      $server{$name}{origin},
      'com.atproto.identity.updateHandle',
      { handle => $new_handle },
      auth_header($server{$name}{access}),
    );
    check($res->is_success, "$name updateHandle succeeds for PLC accounts");
    next unless $res->is_success;
    $server{$name}{renamed_handle} = $new_handle;

    my $handle_res = get_form(
      $server{$name}{origin},
      'com.atproto.identity.resolveHandle',
      { handle => $new_handle },
    );
    check($handle_res->is_success, "$name resolveHandle finds the renamed PLC handle");
    check(($handle_res->json->{did} // q()) eq $server{$name}{did}, "$name renamed PLC handle still resolves to the same DID")
      if $handle_res->is_success;
  }

  note('Comparing PLC token requirements');
  for my $name (sort keys %server) {
    my $res = post_json(
      $server{$name}{origin},
      'com.atproto.identity.signPlcOperation',
      {},
      auth_header($server{$name}{access}),
    );
    check(!$res->is_success, "$name signPlcOperation rejects missing tokens");
    $server{$name}{missing_plc_token_error} = normalize_xrpc_error($res);
  }

  check(
    same_hash($server{reference}{missing_plc_token_error}, $server{perlsky}{missing_plc_token_error}),
    'signPlcOperation matches the official reference PDS token requirement semantics',
  );
}

my $record = {
  '$type'   => 'app.bsky.feed.post',
  text      => 'differential validation post',
  createdAt => '2026-03-10T00:00:00Z',
};

note('Comparing createRecord');
for my $name (sort keys %server) {
  my $res = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    record     => $record,
  }, auth_header($server{$name}{access}));
  check($res->is_success, "$name createRecord succeeds");
  next unless $res->is_success;
  my $json = $res->json;
  $server{$name}{record_uri} = $json->{uri};
  $server{$name}{record_cid} = $json->{cid};
  check(($json->{uri} // q()) =~ m{/app\.bsky\.feed\.post/diffpost\z}, "$name createRecord returns the expected record URI");
  check(defined $json->{cid} && length $json->{cid}, "$name createRecord returns a CID");
}

note('Comparing putRecord update and create semantics');
for my $name (sort keys %server) {
  my $update_res = post_json($server{$name}{origin}, 'com.atproto.repo.putRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    record     => {
      %{$record},
      text => "put update validation for $name",
    },
  }, auth_header($server{$name}{access}));
  check($update_res->is_success, "$name putRecord updates an existing record");

  my $create_res = post_json($server{$name}{origin}, 'com.atproto.repo.putRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'put-created',
    record     => {
      %{$record},
      text => "put create validation for $name",
    },
  }, auth_header($server{$name}{access}));
  check($create_res->is_success, "$name putRecord creates a missing record");

  my $created_record = get_form($server{$name}{origin}, 'com.atproto.repo.getRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'put-created',
  });

  $server{$name}{put_record} = {
    update_ok            => $update_res->is_success ? 1 : 0,
    update_uri_expected  => (($update_res->json || {})->{uri} // q()) =~ m{/app\.bsky\.feed\.post/diffpost\z} ? 1 : 0,
    update_has_cid       => defined(($update_res->json || {})->{cid}) && length(($update_res->json || {})->{cid}) ? 1 : 0,
    create_ok            => $create_res->is_success ? 1 : 0,
    create_uri_expected  => (($create_res->json || {})->{uri} // q()) =~ m{/app\.bsky\.feed\.post/put-created\z} ? 1 : 0,
    create_has_cid       => defined(($create_res->json || {})->{cid}) && length(($create_res->json || {})->{cid}) ? 1 : 0,
    created_record_reads => $created_record->is_success ? 1 : 0,
    created_text_ok      => (($created_record->json || {})->{value}{text} // q()) =~ /^put create validation / ? 1 : 0,
  };
}

check(
  same_hash($server{reference}{put_record}, $server{perlsky}{put_record}),
  'putRecord create-or-update semantics match the official reference PDS',
);

note('Comparing moderation takedown behavior');
for my $name (sort keys %server) {
  my $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      takedown => { applied => true },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name repo takedown succeeds");
  next unless $res->is_success;

  my $blocked_login = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $server{$name}{renamed_handle} || $server{$name}{handle},
    password   => 'hunter22',
  });
  my $allowed_login = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier     => $server{$name}{renamed_handle} || $server{$name}{handle},
    password       => 'hunter22',
    allowTakendown => true,
  });

  my $blocked_write = $allowed_login->is_success
    ? post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
        repo       => $server{$name}{did},
        collection => 'app.bsky.feed.post',
        rkey       => 'takedown-diff',
        record     => {
          %{$record},
          text => "takedown write validation for $name",
        },
      }, auth_header(($allowed_login->json || {})->{accessJwt}))
    : undef;

  my $blocked_list = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
  });

  $server{$name}{repo_takedown} = {
    login_blocked => $blocked_login->is_success ? 0 : 1,
    login_error   => ($blocked_login->json || {})->{error},
    allow_login   => $allowed_login->is_success ? 1 : 0,
    write_blocked => ($blocked_write && !$blocked_write->is_success) ? 1 : 0,
    write_error   => $blocked_write ? (($blocked_write->json || {})->{error}) : undef,
    list_blocked  => $blocked_list->is_success ? 0 : 1,
    list_error    => ($blocked_list->json || {})->{error},
  };

  $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      takedown => { applied => false },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name repo takedown restore succeeds");

  $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.repo.strongRef',
        uri     => $server{$name}{record_uri},
        cid     => $server{$name}{record_cid},
      },
      takedown => { applied => true },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name record takedown succeeds");
  next unless $res->is_success;

  my $record_uri = $server{$name}{record_uri};
  my ($collection, $rkey) = $record_uri =~ m{at://[^/]+/([^/]+)/([^/?#]+)\z};
  my $get_record = get_form($server{$name}{origin}, 'com.atproto.repo.getRecord', {
    repo       => $server{$name}{did},
    collection => $collection,
    rkey       => $rkey,
  });
  my $list_records = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => $collection,
  });

  my $records = $list_records->is_success ? ($list_records->json->{records} || []) : [];
  my $record_hidden = !(grep { (($_->{uri} // q()) eq $record_uri) } @$records);
  $server{$name}{record_takedown} = {
    get_blocked   => $get_record->is_success ? 0 : 1,
    get_error     => ($get_record->json || {})->{error},
    list_hidden   => $record_hidden ? 1 : 0,
    list_success  => $list_records->is_success ? 1 : 0,
  };

  my $sync_record = get_form($server{$name}{origin}, 'com.atproto.sync.getRecord', {
    did        => $server{$name}{did},
    collection => $collection,
    rkey       => $rkey,
  });
  my $sync_car = $sync_record->is_success ? read_car($sync_record->body // q()) : undef;
  $server{$name}{record_takedown_sync} = {
    proof_ok         => $sync_record->is_success ? 1 : 0,
    proof_is_car     => (($sync_record->headers->content_type // q()) =~ m{application/vnd\.ipld\.car}) ? 1 : 0,
    proof_has_record => (
      $sync_car
      && scalar(grep { $_->{cid}->to_string eq $server{$name}{record_cid} } @{ $sync_car->{blocks} || [] })
    ) ? 1 : 0,
  };

  $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.repo.strongRef',
        uri     => $record_uri,
        cid     => $server{$name}{record_cid},
      },
      takedown => { applied => false },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name record takedown restore succeeds");
}

check(
  same_hash($server{reference}{repo_takedown}, $server{perlsky}{repo_takedown}),
  'repo takedown login and write semantics match the official reference PDS',
);

check(
  same_hash($server{reference}{record_takedown}, $server{perlsky}{record_takedown}),
  'record takedown visibility semantics match the official reference PDS',
);

check(
  same_hash($server{reference}{record_takedown_sync}, $server{perlsky}{record_takedown_sync}),
  'record takedown sync proof semantics match the official reference PDS',
);

note('Comparing listRecords');
for my $name (sort keys %server) {
  my $res = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
  });
  check($res->is_success, "$name listRecords succeeds");
  next unless $res->is_success;
  my $records = $res->json->{records} || [];
  check(@{$records} >= 1, "$name listRecords returns at least one record");
  my %by_rkey = map {
    my ($rkey) = (($_->{uri} // q()) =~ m{/([^/?#]+)\z});
    ($rkey // q()) => $_;
  } @$records;
  $server{$name}{list_records} = {
    count               => 0 + @$records,
    has_diffpost        => exists $by_rkey{diffpost} ? 1 : 0,
    diffpost_updated    => (($by_rkey{diffpost}{value}{text} // q()) =~ /^put update validation /) ? 1 : 0,
    has_put_created     => exists $by_rkey{'put-created'} ? 1 : 0,
    put_created_matches => (($by_rkey{'put-created'}{value}{text} // q()) =~ /^put create validation /) ? 1 : 0,
  };
}

check(
  same_hash($server{reference}{list_records}, $server{perlsky}{list_records}),
  'listRecords returns the same normalized record set as the official reference PDS',
);

note('Comparing getLatestCommit');
for my $name (sort keys %server) {
  my $res = get_form($server{$name}{origin}, 'com.atproto.sync.getLatestCommit', { did => $server{$name}{did} });
  check($res->is_success, "$name getLatestCommit succeeds");
  next unless $res->is_success;
  my $json = $res->json;
  $server{$name}{latest_commit_raw} = $json;
  $server{$name}{latest_commit} = {
    has_cid => defined($json->{cid}) && length($json->{cid}) ? 1 : 0,
    has_rev => defined($json->{rev}) && length($json->{rev}) ? 1 : 0,
  };
  check(defined $json->{cid} && length $json->{cid}, "$name getLatestCommit returns a CID");
  check(defined $json->{rev} && length $json->{rev}, "$name getLatestCommit returns a rev");
}

check(
  same_hash($server{reference}{latest_commit}, $server{perlsky}{latest_commit}),
  'getLatestCommit matches the official reference PDS semantics',
);

note('Comparing getHead');
for my $name (sort keys %server) {
  my $res = get_form($server{$name}{origin}, 'com.atproto.sync.getHead', { did => $server{$name}{did} });
  check($res->is_success, "$name getHead succeeds");
  next unless $res->is_success;
  my $json = $res->json || {};
  $server{$name}{head} = {
    has_root               => defined($json->{root}) && length($json->{root}) ? 1 : 0,
    matches_latest_commit  => (($json->{root} // q()) eq (($server{$name}{latest_commit_raw}{cid} // q()))) ? 1 : 0,
  };
}

check(
  same_hash($server{reference}{head}, $server{perlsky}{head}),
  'getHead matches the official reference PDS semantics',
);

note('Comparing getRepo CAR exports');
for my $name (sort keys %server) {
  my $res = get_form($server{$name}{origin}, 'com.atproto.sync.getRepo', { did => $server{$name}{did} });
  check($res->is_success, "$name getRepo succeeds");
  next unless $res->is_success;
  my $ctype = $res->headers->content_type // q();
  check($ctype =~ m{application/vnd\.ipld\.car}, "$name getRepo returns CAR bytes");
  check(length($res->body // q()) > 0, "$name getRepo CAR payload is non-empty");
  $server{$name}{repo_snapshot_car} = $res->body;
  $server{$name}{repo_export} = normalize_repo_export(
    $res->body,
    $server{$name}{latest_commit_raw}{cid},
  );
}

check(
  same_hash($server{reference}{repo_export}, $server{perlsky}{repo_export}),
  'getRepo matches the official reference PDS semantics',
);

note('Comparing getCheckout CAR exports');
for my $name (sort keys %server) {
  my $res = get_form($server{$name}{origin}, 'com.atproto.sync.getCheckout', { did => $server{$name}{did} });
  check($res->is_success, "$name getCheckout succeeds");
  next unless $res->is_success;
  my $ctype = $res->headers->content_type // q();
  my $normalized = normalize_repo_export(
    $res->body,
    $server{$name}{latest_commit_raw}{cid},
  );
  $server{$name}{checkout} = {
    car_type => $ctype =~ m{application/vnd\.ipld\.car} ? 1 : 0,
    nonempty => length($res->body // q()) > 0 ? 1 : 0,
    %{$normalized},
  };
}

check(
  same_hash($server{reference}{checkout}, $server{perlsky}{checkout}),
  'getCheckout matches the official reference PDS semantics',
);

note('Comparing listMissingBlobs empty-state semantics');
for my $name (sort keys %server) {
  my $res = get_form($server{$name}{origin}, 'com.atproto.repo.listMissingBlobs', {}, auth_header($server{$name}{access}));
  check($res->is_success, "$name listMissingBlobs succeeds");
  next unless $res->is_success;
  my $json = $res->json || {};
  $server{$name}{list_missing_blobs} = {
    blobs_empty => (($json->{blobs} && ref($json->{blobs}) eq 'ARRAY' && !@{$json->{blobs}}) ? 1 : 0),
    has_cursor  => exists $json->{cursor} ? 1 : 0,
  };
}

check(
  same_hash($server{reference}{list_missing_blobs}, $server{perlsky}{list_missing_blobs}),
  'listMissingBlobs empty-state semantics match the official reference PDS',
);

note('Comparing importRepo snapshot restore');
for my $name (sort keys %server) {
  my $res = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'import-diff',
    record     => {
      %{$record},
      text => "import validation for $name",
    },
  }, auth_header($server{$name}{access}));
  check($res->is_success, "$name creates an extra record before importRepo");
  next unless $res->is_success;

  $res = post_bytes(
    $server{$name}{origin},
    'com.atproto.repo.importRepo',
    $server{$name}{repo_snapshot_car},
    'application/vnd.ipld.car',
    auth_header($server{$name}{access}),
  );
  check($res->is_success, "$name importRepo succeeds");
  next unless $res->is_success;

  $res = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
  });
  check($res->is_success, "$name listRecords succeeds after importRepo");
  next unless $res->is_success;
  my $records = $res->json->{records} || [];
  my @rkeys = sort map {
    my ($rkey) = (($_->{uri} // q()) =~ m{/([^/?#]+)\z});
    $rkey // q();
  } @$records;
  $server{$name}{import_repo_state} = {
    record_count     => 0 + @$records,
    rkeys            => \@rkeys,
    restored_diffpost => scalar(grep { $_ eq 'diffpost' } @rkeys) ? 1 : 0,
    restored_put     => scalar(grep { $_ eq 'put-created' } @rkeys) ? 1 : 0,
    dropped_import   => scalar(grep { $_ eq 'import-diff' } @rkeys) ? 0 : 1,
  };
}

check(
  same_hash($server{reference}{import_repo_state}, $server{perlsky}{import_repo_state}),
  'importRepo restores the same normalized repo state as the official reference PDS',
);

note('Comparing firehose live follow behavior');
for my $name (sort keys %server) {
  my $quiet = quiet_firehose("$server{$name}{origin}/xrpc/com.atproto.sync.subscribeRepos");
  check($quiet, "$name subscribeRepos stays quiet with no cursor before a new write");
}

for my $name (sort keys %server) {
  my $path = 'app.bsky.feed.post/firehose-diff';
  my $frame = next_commit_frame(
    "$server{$name}{origin}/xrpc/com.atproto.sync.subscribeRepos",
    $path,
    sub {
      my $res = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
        repo       => $server{$name}{did},
        collection => 'app.bsky.feed.post',
        rkey       => 'firehose-diff',
        record     => {
          %{$record},
          text => "firehose validation for $name",
        },
      }, auth_header($server{$name}{access}));
      die "createRecord for firehose failed on $name\n" unless $res->is_success;
    },
  );
  $server{$name}{firehose_commit} = normalize_commit_frame($frame, $server{$name}{did});
  check($server{$name}{firehose_commit}{repo_match}, "$name firehose commit belongs to the created repo");
}

check(
  same_hash($server{reference}{firehose_commit}, $server{perlsky}{firehose_commit}),
  'subscribeRepos emits the same normalized commit semantics as the official reference PDS',
);

