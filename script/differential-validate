sub normalize_swap_message ($message) {
  return 'record-at-cid' if ($message // q()) =~ /\ARecord was at b/i;
  return 'record-at-null' if ($message // q()) eq 'Record was at null';
  return 'commit-at-cid' if ($message // q()) =~ /\ACommit was at b/i;
  return 'commit-at-null' if ($message // q()) eq 'Commit was at null';
  return $message // q();
}

my $root = File::Spec->rel2abs(File::Spec->catdir(dirname(__FILE__), '..'));
my $tmp  = tempdir(CLEANUP => 1);
my @children;
my $failed = 0;

END {
  my $status = $?;
  for my $child (reverse @children) {
    next unless $child->{pid};
    my $alive = kill 0, $child->{pid};
    next unless $alive;
    kill 'TERM', $child->{pid};
    for (1 .. 40) {
      my $done = waitpid($child->{pid}, WNOHANG);
      last if $done == $child->{pid};
      sleep 0.1;
    }
    kill 'KILL', $child->{pid} if kill 0, $child->{pid};
    waitpid($child->{pid}, 0);
  }
  $? = $status;
}

sub note ($message) {
  print "$message\n";
}

sub pass ($message) {
  print "ok - $message\n";
}

sub fail_check ($message) {
  print "not ok - $message\n";
  $failed++;
}

sub check ($condition, $message) {
  if ($condition) {
    pass($message);
  } else {
    fail_check($message);
  }
}

sub free_port () {
  my $sock = IO::Socket::INET->new(
    LocalAddr => '127.0.0.1',
    LocalPort => 0,
    Proto     => 'tcp',
    Listen    => 5,
    ReuseAddr => 1,
  ) or die "unable to allocate a free port: $!";
  my $port = $sock->sockport;
  close $sock;
  return $port;
}

sub spawn_logged ($name, $cmd, $env, $log_path) {
  open my $log_fh, '>', $log_path or die "unable to open $log_path: $!";
  my $pid = fork;
  die "unable to fork for $name: $!" unless defined $pid;

  if ($pid == 0) {
    chdir $root or die "unable to chdir to $root: $!";
    open STDOUT, '>&', $log_fh or die "unable to redirect stdout for $name: $!";
    open STDERR, '>&', $log_fh or die "unable to redirect stderr for $name: $!";
    %ENV = (%ENV, %{$env // {}});
    exec @{$cmd} or die "unable to exec $name: $!";
  }

  close $log_fh;
  my $child = {
    name => $name,
    pid  => $pid,
    log  => $log_path,
  };
  push @children, $child;
  return $child;
}

sub slurp_file ($path) {
  return q() unless -f $path;
  open my $fh, '<', $path or return q();
  local $/;
  return <$fh> // q();
}

sub b64url_decode ($text) {
  my $copy = $text // q();
  $copy =~ tr/-_/+\//;
  my $pad = length($copy) % 4;
  $copy .= '=' x (4 - $pad) if $pad;
  return decode_base64($copy);
}

sub jwt_claims ($jwt) {
  my (undef, $claims_b64, undef) = split /\./, ($jwt // q()), 3;
  return {} unless defined $claims_b64 && length $claims_b64;
  return decode_json(b64url_decode($claims_b64));
}

sub wait_for_ready_file ($name, $path, $timeout = 30) {
  my $deadline = time + $timeout;
  while (time < $deadline) {
    if (-f $path) {
      return decode_json(slurp_file($path));
    }
    sleep 0.1;
  }
  die "timed out waiting for $name ready file $path\n";
}

sub wait_for_http_ok ($name, $url, $timeout = 30) {
  my $ua = Mojo::UserAgent->new(max_redirects => 0);
  my $deadline = time + $timeout;
  while (time < $deadline) {
    my $tx = eval { $ua->get($url) };
    if ($tx) {
      my $res = eval { $tx->result };
      return $res if $res && $res->is_success;
    }
    sleep 0.2;
  }
  die "timed out waiting for $name at $url\n";
}

sub setup_reference_runtime () {
  my @cmd = ($^X, File::Spec->catfile($root, 'script', 'setup-reference-runtime'));
  system(@cmd) == 0 or die "reference runtime setup failed\n";
}

sub random_hex ($bytes) {
  open my $fh, '<:raw', '/dev/urandom' or die "unable to read /dev/urandom: $!";
  read($fh, my $buf, $bytes) == $bytes or die "unable to read $bytes bytes from /dev/urandom\n";
  close $fh;
  return unpack('H*', $buf);
}

sub normalized_domains ($res) {
  my $json = $res->json || {};
  return [ sort map { /^\./ ? $_ : ".$_" } @{ $json->{availableUserDomains} || [] } ];
}

sub normalize_commit_frame ($frame, $did) {
  my $header = $frame->{header} || {};
  my $body   = $frame->{body}   || {};
  my $first  = $body->{ops}[0] || {};
  my $commit_prev_is_null = 0;
  my $blocks_count = 0;
  my $commit_block_present = 0;

  if (defined $body->{commit} && defined $body->{blocks}) {
    my $car = read_car($body->{blocks});
    $blocks_count = scalar @{ $car->{blocks} || [] };
    my ($commit_block) = grep {
      $_->{cid}->to_string eq $body->{commit}->to_string
    } @{ $car->{blocks} || [] };
    if ($commit_block) {
      $commit_block_present = 1;
      my $commit = decode_dag_cbor($commit_block->{bytes});
      $commit_prev_is_null = exists($commit->{prev}) && !defined($commit->{prev}) ? 1 : 0;
    }
  }

  return {
    op                  => $header->{op},
    type                => $header->{t},
    repo_match          => (($body->{repo} // q()) eq $did) ? 1 : 0,
    action              => $first->{action},
    path                => $first->{path},
    ops_count           => 0 + @{ $body->{ops} || [] },
    cid_present         => defined($first->{cid}) ? 1 : 0,
    prev_present        => defined($first->{prev}) ? 1 : 0,
    prev_data_present   => defined($body->{prevData}) ? 1 : 0,
    has_blocks          => length($body->{blocks} // q()) > 0 ? 1 : 0,
    has_commit          => defined $body->{commit} ? 1 : 0,
    has_since           => exists($body->{since}) ? 1 : 0,
    since_is_stringish  => !defined($body->{since}) || !ref($body->{since}) ? 1 : 0,
    seq_is_int          => defined($body->{seq}) && $body->{seq} =~ /\A\d+\z/ ? 1 : 0,
    too_big             => $body->{tooBig} ? 1 : 0,
    blocks_count        => $blocks_count,
    commit_block_present => $commit_block_present,
    commit_prev_is_null => $commit_prev_is_null,
  };
}

sub normalize_repo_export ($car_bytes, $expected_root = undef) {
  my $car = read_car($car_bytes // q());
  my @roots = @{ $car->{roots} || [] };
  my @blocks = @{ $car->{blocks} || [] };
  my %block_cids = map { $_->{cid}->to_string => 1 } @blocks;
  my $root = @roots ? $roots[0]->to_string : undef;
  return {
    roots_count          => 0 + @roots,
    blocks_count         => 0 + @blocks,
    root_present         => defined($root) ? 1 : 0,
    root_in_blocks       => (defined($root) && $block_cids{$root}) ? 1 : 0,
    root_matches_latest  => (defined($root) && defined($expected_root) && $root eq $expected_root) ? 1 : 0,
  };
}

sub normalize_bootstrap_frames ($frames, $did, $handle) {
  return [
    map {
      my $header = $_->{header} || {};
      my $body   = $_->{body}   || {};
      my $type   = $header->{t} // q();
      my %normalized = (
        type => $type,
      );
      if ($type eq '#identity') {
        %normalized = (
          %normalized,
          did_match    => (($body->{did} // q()) eq $did) ? 1 : 0,
          handle_match => (($body->{handle} // q()) eq $handle) ? 1 : 0,
        );
      } elsif ($type eq '#account') {
        %normalized = (
          %normalized,
          did_match => (($body->{did} // q()) eq $did) ? 1 : 0,
          active    => $body->{active} ? 1 : 0,
        );
      } elsif ($type eq '#commit') {
        %normalized = (
          %normalized,
          repo_match => (($body->{repo} // q()) eq $did) ? 1 : 0,
          ops_count  => 0 + @{ $body->{ops} || [] },
          has_blocks => length($body->{blocks} // q()) > 0 ? 1 : 0,
        );
      } elsif ($type eq '#sync') {
        %normalized = (
          %normalized,
          did_match  => (($body->{did} // q()) eq $did) ? 1 : 0,
          has_blocks => length($body->{blocks} // q()) > 0 ? 1 : 0,
        );
      }
      \%normalized;
    } @$frames
  ];
}

sub same_hash ($left, $right) {
  my $json = JSON::PP->new->canonical(1)->allow_nonref(1);
  return $json->encode($left) eq $json->encode($right);
}

sub normalize_did_doc ($doc, $expected_did, $expected_handle, $expected_origin) {
  my @services = grep { (($_->{id} // q()) eq '#atproto_pds') || (($_->{id} // q()) =~ /atproto_pds\z/) } @{ $doc->{service} || [] };
  my @methods  = grep { (($_->{id} // q()) eq '#atproto') || (($_->{id} // q()) =~ /#atproto\z/) } @{ $doc->{verificationMethod} || [] };
  my $service  = $services[0] || {};
  my $method   = $methods[0]  || {};
  return {
    id_matches            => (($doc->{id} // q()) eq $expected_did) ? 1 : 0,
    handle_matches        => (((($doc->{alsoKnownAs} || [])->[0]) // q()) eq "at://$expected_handle") ? 1 : 0,
    service_endpoint_ok   => (($service->{serviceEndpoint} // q()) eq $expected_origin) ? 1 : 0,
    service_type_ok       => (($service->{type} // q()) eq 'AtprotoPersonalDataServer') ? 1 : 0,
    verification_type_set => defined($method->{type}) && length($method->{type}) ? 1 : 0,
    verification_key_set  => defined($method->{publicKeyMultibase}) && ($method->{publicKeyMultibase} =~ /\Az/) ? 1 : 0,
  };
}

sub normalize_plc_credentials ($json, $expected_handle, $expected_origin) {
  return {
    handle_matches       => (((($json->{alsoKnownAs} || [])->[0]) // q()) eq "at://$expected_handle") ? 1 : 0,
    verification_is_did  => (($json->{verificationMethods}{atproto} // q()) =~ /\Adid:key:/) ? 1 : 0,
    rotation_key_count   => 0 + @{ $json->{rotationKeys} || [] },
    all_rotation_are_did => @{ $json->{rotationKeys} || [] }
      ? ((grep { ($_ // q()) =~ /\Adid:key:/ } @{ $json->{rotationKeys} || [] }) == @{ $json->{rotationKeys} || [] } ? 1 : 0)
      : 0,
    service_endpoint_ok  => (($json->{services}{atproto_pds}{endpoint} // q()) eq $expected_origin) ? 1 : 0,
    service_type_ok      => (($json->{services}{atproto_pds}{type} // q()) eq 'AtprotoPersonalDataServer') ? 1 : 0,
  };
}

sub normalize_signed_plc_operation ($json, $expected_handle, $expected_origin) {
  my $op = $json->{operation} || {};
  return {
    type_ok              => (($op->{type} // q()) eq 'plc_operation') ? 1 : 0,
    handle_matches       => (((($op->{alsoKnownAs} || [])->[0]) // q()) eq "at://$expected_handle") ? 1 : 0,
    verification_is_did  => (($op->{verificationMethods}{atproto} // q()) =~ /\Adid:key:/) ? 1 : 0,
    rotation_key_count   => 0 + @{ $op->{rotationKeys} || [] },
    service_endpoint_ok  => (($op->{services}{atproto_pds}{endpoint} // q()) eq $expected_origin) ? 1 : 0,
    has_prev             => defined($op->{prev}) && length($op->{prev}) ? 1 : 0,
    has_sig              => defined($op->{sig})  && length($op->{sig})  ? 1 : 0,
  };
}

sub normalize_xrpc_error ($res) {
  my $json = $res->json || {};
  return {
    status => $res->code,
    error  => $json->{error},
  };
}

sub crawler_requests ($origin) {
  my $res = get_json_url("$origin/requests");
  die "crawler request log fetch failed for $origin\n" unless $res->is_success;
  return $res->json || {};
}

sub wait_for_crawler_requests ($name, $origin, $minimum = 1, $timeout = 10) {
  my $deadline = time + $timeout;
  while (time < $deadline) {
    my $state = eval { crawler_requests($origin) };
    if ($state && (($state->{count} // 0) >= $minimum)) {
      return $state;
    }
    sleep 0.1;
  }
  die "timed out waiting for $name crawler requests at $origin\n";
}

sub sqlite_dbh ($path) {
  return DBI->connect(
    "dbi:SQLite:dbname=$path",
    q(),
    q(),
    {
      RaiseError => 1,
      PrintError => 0,
      AutoCommit => 1,
    },
  );
}

sub latest_email_token_record ($server, $purpose_key, $did) {
  my $purpose = $server->{token_purpose}{$purpose_key} // die "unknown token purpose $purpose_key\n";
  my $dbh = sqlite_dbh($server->{db_path});
  my ($sql, @bind);
  if (($server->{token_backend} // q()) eq 'reference') {
    $sql = q{
      SELECT did, purpose, token, requestedAt
      FROM email_token
      WHERE did = ? AND purpose = ?
      ORDER BY requestedAt DESC
      LIMIT 1
    };
    @bind = ($did, $purpose);
  } else {
    $sql = q{
      SELECT did, purpose, token, email, created_at, expires_at, consumed_at
      FROM action_tokens
      WHERE did = ? AND purpose = ?
      ORDER BY rowid DESC
      LIMIT 1
    };
    @bind = ($did, $purpose);
  }
  my $row = $dbh->selectrow_hashref($sql, undef, @bind);
  $dbh->disconnect;
  return $row;
}

sub expire_email_token_record ($server, $purpose_key, $did) {
  my $purpose = $server->{token_purpose}{$purpose_key} // die "unknown token purpose $purpose_key\n";
  my $dbh = sqlite_dbh($server->{db_path});
  if (($server->{token_backend} // q()) eq 'reference') {
    $dbh->do(
      q{UPDATE email_token SET requestedAt = ? WHERE did = ? AND purpose = ?},
      undef,
      '2000-01-01T00:00:00.000Z',
      $did,
      $purpose,
    );
  } else {
    $dbh->do(
      q{UPDATE action_tokens SET expires_at = ? WHERE did = ? AND purpose = ? AND consumed_at IS NULL},
      undef,
      1,
      $did,
      $purpose,
    );
  }
  $dbh->disconnect;
  return;
}

