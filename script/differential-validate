note('Comparing importRepo snapshot restore');
for my $name (sort keys %server) {
  my $res = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'import-diff',
    record     => {
      %{$record},
      text => "import validation for $name",
    },
  }, auth_header($server{$name}{access}));
  check($res->is_success, "$name creates an extra record before importRepo");
  next unless $res->is_success;

  $res = post_bytes(
    $server{$name}{origin},
    'com.atproto.repo.importRepo',
    $server{$name}{repo_snapshot_car},
    'application/vnd.ipld.car',
    auth_header($server{$name}{access}),
  );
  check($res->is_success, "$name importRepo succeeds");
  next unless $res->is_success;

  $res = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
  });
  check($res->is_success, "$name listRecords succeeds after importRepo");
  next unless $res->is_success;
  my $records = $res->json->{records} || [];
  my @rkeys = sort map {
    my ($rkey) = (($_->{uri} // q()) =~ m{/([^/?#]+)\z});
    $rkey // q();
  } @$records;
  $server{$name}{import_repo_state} = {
    record_count     => 0 + @$records,
    rkeys            => \@rkeys,
    restored_diffpost => scalar(grep { $_ eq 'diffpost' } @rkeys) ? 1 : 0,
    restored_put     => scalar(grep { $_ eq 'put-created' } @rkeys) ? 1 : 0,
    dropped_import   => scalar(grep { $_ eq 'import-diff' } @rkeys) ? 0 : 1,
  };
}

check(
  same_hash($server{reference}{import_repo_state}, $server{perlsky}{import_repo_state}),
  'importRepo restores the same normalized repo state as the official reference PDS',
);

note('Comparing firehose live follow behavior');
for my $name (sort keys %server) {
  my $quiet = quiet_firehose("$server{$name}{origin}/xrpc/com.atproto.sync.subscribeRepos");
  check($quiet, "$name subscribeRepos stays quiet with no cursor before a new write");
}

for my $name (sort keys %server) {
  my $path = 'app.bsky.feed.post/firehose-diff';
  my $frame = next_commit_frame(
    "$server{$name}{origin}/xrpc/com.atproto.sync.subscribeRepos",
    $path,
    sub {
      my $res = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
        repo       => $server{$name}{did},
        collection => 'app.bsky.feed.post',
        rkey       => 'firehose-diff',
        record     => {
          %{$record},
          text => "firehose validation for $name",
        },
      }, auth_header($server{$name}{access}));
      die "createRecord for firehose failed on $name\n" unless $res->is_success;
    },
  );
  $server{$name}{firehose_commit} = normalize_commit_frame($frame, $server{$name}{did});
  check($server{$name}{firehose_commit}{repo_match}, "$name firehose commit belongs to the created repo");
}

check(
  same_hash($server{reference}{firehose_commit}, $server{perlsky}{firehose_commit}),
  'subscribeRepos emits the same normalized commit semantics as the official reference PDS',
);

