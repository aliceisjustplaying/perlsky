note('Comparing describeServer');
for my $name (sort keys %server) {
  my $res = get_json($server{$name}{origin}, 'com.atproto.server.describeServer');
  check($res->is_success, "$name describeServer succeeds");
  $server{$name}{describe} = $res->json if $res->is_success;
}

check(
  same_hash(
    {
      inviteCodeRequired => $server{reference}{describe}{inviteCodeRequired} ? true : false,
      availableUserDomains => normalized_domains(get_json($server{reference}{origin}, 'com.atproto.server.describeServer')),
    },
    {
      inviteCodeRequired => $server{perlsky}{describe}{inviteCodeRequired} ? true : false,
      availableUserDomains => normalized_domains(get_json($server{perlsky}{origin}, 'com.atproto.server.describeServer')),
    },
  ),
  'describeServer matches on invite requirement and user domains',
);

note('Creating matching accounts');
for my $name (sort keys %server) {
  my $res = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => $server{$name}{handle},
    email    => $server{$name}{email},
    password => 'hunter22',
  });
  check($res->is_success, "$name createAccount succeeds");
  next unless $res->is_success;

  my $json = $res->json;
  $server{$name}{did} = $json->{did};
  $server{$name}{access} = $json->{accessJwt};
  $server{$name}{refresh} = $json->{refreshJwt};
  $server{$name}{create_account} = $json;

  check(($json->{handle} // q()) eq $server{$name}{handle}, "$name createAccount returns normalized handle");
  check(defined $json->{did} && $json->{did} =~ /\Adid:/, "$name createAccount returns a DID");
  check(defined $json->{accessJwt} && length $json->{accessJwt}, "$name createAccount returns an access token");
  check(defined $json->{refreshJwt} && length $json->{refreshJwt}, "$name createAccount returns a refresh token");
  check(($json->{did} // q()) =~ /\Adid:plc:/, "$name createAccount returns a PLC DID")
    if $diff_account_did_method eq 'did:plc';
}

note('Creating secondary accounts for conflict checks');
for my $name (sort keys %server) {
  my $res = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => $name eq 'reference' ? 'bob-ref.test' : 'bob-perl.test',
    email    => $name eq 'reference' ? 'bob-ref@test.com' : 'bob-perl@test.com',
    password => 'hunter22',
  });
  check($res->is_success, "$name secondary createAccount succeeds");
  next unless $res->is_success;
  my $json = $res->json || {};
  $server{$name}{secondary_did}    = $json->{did};
  $server{$name}{secondary_handle} = $json->{handle};
  $server{$name}{secondary_email}  = $name eq 'reference' ? 'bob-ref@test.com' : 'bob-perl@test.com';
}

note('Comparing account password boundary semantics');
for my $name (sort keys %server) {
  my $too_long_create = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => "toolong-$name-" . substr(random_hex(3), 0, 6),
    email    => "toolong-$name-" . substr(random_hex(3), 0, 6) . '@test.com',
    password => ('x' x 257),
  });
  my $invalid_email_create = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => "bademail-$name-" . substr(random_hex(3), 0, 6),
    email    => 'not-an-email',
    password => 'hunter22',
  });
  my $duplicate_email_create = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => "dupemail-$name-" . substr(random_hex(3), 0, 6),
    email    => uc($server{$name}{email}),
    password => 'hunter22',
  });
  my $duplicate_handle_create = post_json($server{$name}{origin}, 'com.atproto.server.createAccount', {
    handle   => uc($server{$name}{handle}),
    email    => "duphandle-$name-" . substr(random_hex(3), 0, 6) . '@test.com',
    password => 'hunter22',
  });
  my $too_long_session = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $server{$name}{handle},
    password   => ('x' x 513),
  });
  my $password_reset_upper = post_json($server{$name}{origin}, 'com.atproto.server.requestPasswordReset', {
    email => uc($server{$name}{email}),
  });

  $server{$name}{password_boundaries} = {
    create_too_long  => normalize_xrpc_error($too_long_create),
    create_bad_email => normalize_xrpc_error($invalid_email_create),
    create_dup_email => normalize_xrpc_error($duplicate_email_create),
    create_dup_handle => normalize_xrpc_error($duplicate_handle_create),
    session_too_long => normalize_xrpc_error($too_long_session),
    reset_uppercase  => {
      status     => $password_reset_upper->code // 0,
      success    => $password_reset_upper->is_success ? 1 : 0,
      empty_body => same_hash($password_reset_upper->json || {}, {}) ? 1 : 0,
    },
  };
}

if (!same_hash($server{reference}{password_boundaries}, $server{perlsky}{password_boundaries})) {
  note('reference password boundaries: ' . encode_json($server{reference}{password_boundaries}));
  note('perlsky password boundaries: ' . encode_json($server{perlsky}{password_boundaries}));
  fail_check('account password boundary and reset-email semantics match the official reference PDS');
} else {
  pass('account password boundary and reset-email semantics match the official reference PDS');
}

