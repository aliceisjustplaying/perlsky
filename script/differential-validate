  my $res = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
  });
  check($res->is_success, "$name listRecords succeeds");
  next unless $res->is_success;
  my $records = $res->json->{records} || [];
  check(@{$records} >= 1, "$name listRecords returns at least one record");
  my %by_rkey = map {
    my ($rkey) = (($_->{uri} // q()) =~ m{/([^/?#]+)\z});
    ($rkey // q()) => $_;
