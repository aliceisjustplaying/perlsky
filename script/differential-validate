note('Comparing getServiceAuth post-takedown behavior');
for my $name (sort keys %server) {
  my $update = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      takedown => { applied => true },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($update->is_success, "$name repo takedown succeeds before service-auth comparison");
  next unless $update->is_success;

  my $blocked = get_form(
    $server{$name}{origin},
    'com.atproto.server.getServiceAuth',
    {
      aud => 'did:web:api.bsky.app',
      lxm => 'app.bsky.actor.getPreferences',
    },
    auth_header($server{$name}{access}),
  );
  my $migration = get_form(
    $server{$name}{origin},
    'com.atproto.server.getServiceAuth',
    {
      aud => 'did:web:api.bsky.app',
      lxm => 'com.atproto.server.createAccount',
    },
    auth_header($server{$name}{access}),
  );
  my $blocked_json = $blocked->json || {};
  my $migration_json = $migration->json || {};

  $server{$name}{service_auth_takedown} = {
    standard_ok      => $blocked->is_success ? 1 : 0,
    standard_token   => (length($blocked_json->{token} // q()) ? 1 : 0),
    migration_ok     => $migration->is_success ? 1 : 0,
    migration_token  => (length($migration_json->{token} // q()) ? 1 : 0),
  };
}

check(
  same_hash($server{reference}{service_auth_takedown}, $server{perlsky}{service_auth_takedown}),
  'getServiceAuth agrees on post-takedown behavior',
);

