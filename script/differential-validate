note('Comparing refreshSession token rotation');
for my $name (sort keys %server) {
  my $res = post_empty(
    $server{$name}{origin},
    'com.atproto.server.refreshSession',
    auth_header($server{$name}{refresh}),
  );
  check($res->is_success, "$name refreshSession succeeds");
  next unless $res->is_success;
  my $json = $res->json || {};
  my $old_access = $server{$name}{access};
  my $old_refresh = $server{$name}{refresh};
  my $old_refresh_claims = jwt_claims($old_refresh);
  $server{$name}{access} = $json->{accessJwt};
  $server{$name}{refresh} = $json->{refreshJwt};
  my $new_refresh_claims = jwt_claims($server{$name}{refresh});

  my $old_access_res = get_json(
    $server{$name}{origin},
    'com.atproto.server.getSession',
    undef,
    auth_header($old_access),
  );
  my $old_refresh_res = post_empty(
    $server{$name}{origin},
    'com.atproto.server.refreshSession',
    auth_header($old_refresh),
  );
  my $new_access_res = get_json(
    $server{$name}{origin},
    'com.atproto.server.getSession',
    undef,
    auth_header($server{$name}{access}),
  );
  my $old_refresh_json = $old_refresh_res->json || {};
  my $reused_refresh_claims = jwt_claims($old_refresh_json->{refreshJwt});

  $server{$name}{refresh_rotation} = {
    has_access_jwt          => length($json->{accessJwt} // q()) ? 1 : 0,
    has_refresh_jwt         => length($json->{refreshJwt} // q()) ? 1 : 0,
    refresh_rotated         => (($new_refresh_claims->{jti} // q()) ne ($old_refresh_claims->{jti} // q())) ? 1 : 0,
    old_access_works        => $old_access_res->is_success ? 1 : 0,
    old_refresh_works       => $old_refresh_res->is_success ? 1 : 0,
    reused_refresh_matches  => $old_refresh_res->is_success
      && (($reused_refresh_claims->{jti} // q()) eq ($new_refresh_claims->{jti} // q()))
      ? 1
      : 0,
    new_access_works        => $new_access_res->is_success ? 1 : 0,
  };
}

check(
  same_hash($server{reference}{refresh_rotation}, $server{perlsky}{refresh_rotation}),
  'refreshSession grace and successor semantics match the official reference PDS',
);

note('Comparing app password semantics');
for my $name (sort keys %server) {
  my $create_phone = post_json(
    $server{$name}{origin},
    'com.atproto.server.createAppPassword',
    { name => 'phone' },
    auth_header($server{$name}{access}),
  );
  check($create_phone->is_success, "$name createAppPassword succeeds for a standard app password");

  my $create_desktop = post_json(
    $server{$name}{origin},
    'com.atproto.server.createAppPassword',
    {
      name       => 'desktop',
      privileged => true,
    },
    auth_header($server{$name}{access}),
  );
  check($create_desktop->is_success, "$name createAppPassword succeeds for a privileged app password");
  next unless $create_phone->is_success && $create_desktop->is_success;

  my $phone_json   = $create_phone->json   || {};
  my $desktop_json = $create_desktop->json || {};

  my $list_before = get_json(
    $server{$name}{origin},
    'com.atproto.server.listAppPasswords',
    undef,
    auth_header($server{$name}{access}),
  );
  check($list_before->is_success, "$name listAppPasswords succeeds after creation");

  my $phone_session = post_json(
    $server{$name}{origin},
    'com.atproto.server.createSession',
    {
      identifier => $server{$name}{handle},
      password   => $phone_json->{password},
    },
  );
  check($phone_session->is_success, "$name createSession succeeds with the standard app password");

  my $desktop_session = post_json(
    $server{$name}{origin},
    'com.atproto.server.createSession',
    {
      identifier => $server{$name}{handle},
      password   => $desktop_json->{password},
    },
  );
  check($desktop_session->is_success, "$name createSession succeeds with the privileged app password");

  my $phone_access   = ($phone_session->json   || {})->{accessJwt};
  my $phone_refresh  = ($phone_session->json   || {})->{refreshJwt};
  my $desktop_access = ($desktop_session->json || {})->{accessJwt};

  my $nested_create = post_json(
    $server{$name}{origin},
    'com.atproto.server.createAppPassword',
    { name => 'nested' },
    auth_header($phone_access),
  );
  my $phone_list = get_json(
    $server{$name}{origin},
    'com.atproto.server.listAppPasswords',
    undef,
    auth_header($phone_access),
  );
  my $phone_service_auth = get_form(
    $server{$name}{origin},
    'com.atproto.server.getServiceAuth',
    {
      aud => 'did:web:api.bsky.app',
      lxm => 'com.atproto.server.createaccount',
    },
    auth_header($phone_access),
  );
  my $desktop_service_auth = get_form(
    $server{$name}{origin},
    'com.atproto.server.getServiceAuth',
    {
      aud => 'did:web:api.bsky.app',
      lxm => 'com.atproto.server.createaccount',
    },
    auth_header($desktop_access),
  );

  my $revoke_phone = post_json(
    $server{$name}{origin},
    'com.atproto.server.revokeAppPassword',
    { name => 'phone' },
    auth_header($server{$name}{access}),
  );
  check($revoke_phone->is_success, "$name revokeAppPassword succeeds for the standard app password");

  my $revoked_refresh = post_empty(
    $server{$name}{origin},
    'com.atproto.server.refreshSession',
    auth_header($phone_refresh),
  );
  my $list_after = get_json(
    $server{$name}{origin},
    'com.atproto.server.listAppPasswords',
    undef,
    auth_header($server{$name}{access}),
  );

  my %before_passwords = map {
    (
      ($_->{name} // q()) => {
        privileged => $_->{privileged} ? 1 : 0,
      }
    )
  } @{ ($list_before->json || {})->{passwords} || [] };

  my %after_passwords = map {
    (
      ($_->{name} // q()) => {
        privileged => $_->{privileged} ? 1 : 0,
      }
    )
  } @{ ($list_after->json || {})->{passwords} || [] };

  $server{$name}{app_passwords} = {
    phone_create => {
      name            => $phone_json->{name} // q(),
      has_password    => length($phone_json->{password} // q()) ? 1 : 0,
      privileged      => $phone_json->{privileged} ? 1 : 0,
    },
    desktop_create => {
      name            => $desktop_json->{name} // q(),
      has_password    => length($desktop_json->{password} // q()) ? 1 : 0,
      privileged      => $desktop_json->{privileged} ? 1 : 0,
    },
    list_before => {
      passwords => \%before_passwords,
    },
    phone_session_scope    => jwt_claims($phone_access)->{scope} // q(),
    desktop_session_scope  => jwt_claims($desktop_access)->{scope} // q(),
    nested_create_error    => normalize_xrpc_error($nested_create),
    phone_list_error       => normalize_xrpc_error($phone_list),
    phone_service_auth     => normalize_xrpc_error($phone_service_auth),
    desktop_service_auth   => {
      status    => $desktop_service_auth->code,
      has_token => length((($desktop_service_auth->json || {})->{token}) // q()) ? 1 : 0,
    },
    revoked_refresh_error  => normalize_xrpc_error($revoked_refresh),
    list_after => {
      passwords => \%after_passwords,
    },
  };
}

if (!same_hash($server{reference}{app_passwords}, $server{perlsky}{app_passwords})) {
  note('reference app passwords: ' . encode_json($server{reference}{app_passwords}));
  note('perlsky app passwords: ' . encode_json($server{perlsky}{app_passwords}));
  fail_check('app password lifecycle semantics match the official reference PDS');
} else {
  pass('app password lifecycle semantics match the official reference PDS');
}

if ($diff_account_did_method eq 'did:plc') {
  note('Comparing PLC identity semantics');
  for my $name (sort keys %server) {
    my $res = get_json(
      $server{$name}{origin},
      'com.atproto.identity.getRecommendedDidCredentials',
      undef,
      auth_header($server{$name}{access}),
    );
    check($res->is_success, "$name getRecommendedDidCredentials succeeds");
    next unless $res->is_success;
    $server{$name}{recommended_did} = normalize_plc_credentials(
      $res->json || {},
      $server{$name}{handle},
      $server{$name}{origin},
    );
  }

  check(
    same_hash($server{reference}{recommended_did}, $server{perlsky}{recommended_did}),
    'getRecommendedDidCredentials matches the official reference PDS semantics',
  );

  note('Comparing PLC signature requests');
  for my $name (sort keys %server) {
    my $res = post_empty(
      $server{$name}{origin},
      'com.atproto.identity.requestPlcOperationSignature',
      auth_header($server{$name}{access}),
    );
    check($res->is_success, "$name requestPlcOperationSignature succeeds");
  }

  note('Comparing PLC handle updates');
  for my $name (sort keys %server) {
    my $new_handle = $name eq 'reference' ? 'alice-renamed-ref.test' : 'alice-renamed-perl.test';
    my $res = post_json(
      $server{$name}{origin},
      'com.atproto.identity.updateHandle',
      { handle => $new_handle },
      auth_header($server{$name}{access}),
    );
    check($res->is_success, "$name updateHandle succeeds for PLC accounts");
    next unless $res->is_success;
    $server{$name}{renamed_handle} = $new_handle;

    my $handle_res = get_form(
      $server{$name}{origin},
      'com.atproto.identity.resolveHandle',
      { handle => $new_handle },
    );
    check($handle_res->is_success, "$name resolveHandle finds the renamed PLC handle");
    check(($handle_res->json->{did} // q()) eq $server{$name}{did}, "$name renamed PLC handle still resolves to the same DID")
      if $handle_res->is_success;
  }

  note('Comparing PLC token requirements');
  for my $name (sort keys %server) {
    my $res = post_json(
      $server{$name}{origin},
      'com.atproto.identity.signPlcOperation',
      {},
      auth_header($server{$name}{access}),
    );
    check(!$res->is_success, "$name signPlcOperation rejects missing tokens");
    $server{$name}{missing_plc_token_error} = normalize_xrpc_error($res);
  }

  check(
    same_hash($server{reference}{missing_plc_token_error}, $server{perlsky}{missing_plc_token_error}),
    'signPlcOperation matches the official reference PDS token requirement semantics',
  );

  note('Comparing PLC submitPlcOperation validation');
  for my $name (sort keys %server) {
    my $res = post_json(
      $server{$name}{origin},
      'com.atproto.identity.submitPlcOperation',
      { operation => {} },
      auth_header($server{$name}{access}),
    );
    check(!$res->is_success, "$name submitPlcOperation rejects malformed operations");
    $server{$name}{invalid_plc_operation_error} = normalize_xrpc_error($res);
  }

  check(
    same_hash($server{reference}{invalid_plc_operation_error}, $server{perlsky}{invalid_plc_operation_error}),
    'submitPlcOperation matches the official reference PDS invalid-operation semantics',
  );
}

my $record = {
  '$type'   => 'app.bsky.feed.post',
  text      => 'differential validation post',
  createdAt => '2026-03-10T00:00:00Z',
};

note('Comparing createRecord');
for my $name (sort keys %server) {
  my $res = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    record     => $record,
  }, auth_header($server{$name}{access}));
  check($res->is_success, "$name createRecord succeeds");
  next unless $res->is_success;
  my $json = $res->json;
  $server{$name}{record_uri} = $json->{uri};
  $server{$name}{record_cid} = $json->{cid};
  check(($json->{uri} // q()) =~ m{/app\.bsky\.feed\.post/diffpost\z}, "$name createRecord returns the expected record URI");
  check(defined $json->{cid} && length $json->{cid}, "$name createRecord returns a CID");
}

note('Comparing putRecord update and create semantics');
for my $name (sort keys %server) {
  my $update_res = post_json($server{$name}{origin}, 'com.atproto.repo.putRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    record     => {
      %{$record},
      text => "put update validation for $name",
    },
  }, auth_header($server{$name}{access}));
  check($update_res->is_success, "$name putRecord updates an existing record");

  my $create_res = post_json($server{$name}{origin}, 'com.atproto.repo.putRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'put-created',
    record     => {
      %{$record},
      text => "put create validation for $name",
    },
  }, auth_header($server{$name}{access}));
  check($create_res->is_success, "$name putRecord creates a missing record");

  my $created_record = get_form($server{$name}{origin}, 'com.atproto.repo.getRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'put-created',
  });

  $server{$name}{put_record} = {
    update_ok            => $update_res->is_success ? 1 : 0,
    update_uri_expected  => (($update_res->json || {})->{uri} // q()) =~ m{/app\.bsky\.feed\.post/diffpost\z} ? 1 : 0,
    update_has_cid       => defined(($update_res->json || {})->{cid}) && length(($update_res->json || {})->{cid}) ? 1 : 0,
    create_ok            => $create_res->is_success ? 1 : 0,
    create_uri_expected  => (($create_res->json || {})->{uri} // q()) =~ m{/app\.bsky\.feed\.post/put-created\z} ? 1 : 0,
    create_has_cid       => defined(($create_res->json || {})->{cid}) && length(($create_res->json || {})->{cid}) ? 1 : 0,
    created_record_reads => $created_record->is_success ? 1 : 0,
    created_text_ok      => (($created_record->json || {})->{value}{text} // q()) =~ /^put create validation / ? 1 : 0,
  };
  $server{$name}{updated_record_cid} = ($update_res->json || {})->{cid};
}

check(
  same_hash($server{reference}{put_record}, $server{perlsky}{put_record}),
  'putRecord create-or-update semantics match the official reference PDS',
);

note('Comparing applyWrites');
for my $name (sort keys %server) {
  my $seed_update = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'apply-update-target',
    record     => {
      %{$record},
      text => "applyWrites seed update for $name",
    },
  }, auth_header($server{$name}{access}));
  check($seed_update->is_success, "$name applyWrites seed update record succeeds");

  my $seed_delete = post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'apply-delete-target',
    record     => {
      %{$record},
      text => "applyWrites seed delete for $name",
    },
  }, auth_header($server{$name}{access}));
  check($seed_delete->is_success, "$name applyWrites seed delete record succeeds");
  next unless $seed_update->is_success && $seed_delete->is_success;

  my $apply = post_json($server{$name}{origin}, 'com.atproto.repo.applyWrites', {
    repo   => $server{$name}{did},
    writes => [
      {
        '$type'    => 'com.atproto.repo.applyWrites#create',
        collection => 'app.bsky.feed.post',
        rkey       => 'apply-created',
        value      => {
          '$type'   => 'app.bsky.feed.post',
          text      => "applyWrites create for $name",
          createdAt => '2026-03-12T00:00:01Z',
        },
      },
      {
        '$type'    => 'com.atproto.repo.applyWrites#update',
        collection => 'app.bsky.feed.post',
        rkey       => 'apply-update-target',
        value      => {
          '$type'   => 'app.bsky.feed.post',
          text      => "applyWrites update for $name",
          createdAt => '2026-03-12T00:00:02Z',
        },
      },
      {
        '$type'    => 'com.atproto.repo.applyWrites#delete',
        collection => 'app.bsky.feed.post',
        rkey       => 'apply-delete-target',
      },
    ],
  }, auth_header($server{$name}{access}));
  check($apply->is_success, "$name applyWrites succeeds");

  my $created = get_form($server{$name}{origin}, 'com.atproto.repo.getRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'apply-created',
  });
  my $updated = get_form($server{$name}{origin}, 'com.atproto.repo.getRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'apply-update-target',
  });
  my $deleted = get_form($server{$name}{origin}, 'com.atproto.repo.getRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'apply-delete-target',
  });
  my $missing_delete = post_json($server{$name}{origin}, 'com.atproto.repo.applyWrites', {
    repo   => $server{$name}{did},
    writes => [
      {
        '$type'    => 'com.atproto.repo.applyWrites#delete',
        collection => 'app.bsky.feed.post',
        rkey       => 'apply-missing-target',
      },
    ],
  }, auth_header($server{$name}{access}));

  my $apply_json = $apply->json || {};
  my $results = $apply_json->{results} || [];
  $server{$name}{apply_writes} = {
    ok                    => $apply->is_success ? 1 : 0,
    has_commit            => ref($apply_json->{commit}) eq 'HASH' ? 1 : 0,
    results_count         => 0 + @$results,
    create_result_type    => ($results->[0]{'$type'} // q()),
    update_result_type    => ($results->[1]{'$type'} // q()),
    delete_result_type    => ($results->[2]{'$type'} // q()),
    created_text_ok       => (($created->json || {})->{value}{text} // q()) =~ /\AapplyWrites create / ? 1 : 0,
    updated_text_ok       => (($updated->json || {})->{value}{text} // q()) =~ /\AapplyWrites update / ? 1 : 0,
    deleted_missing       => $deleted->is_success ? 0 : 1,
    deleted_error         => ($deleted->json || {})->{error} // q(),
  };
  $server{$name}{apply_writes_missing_delete_error} = normalize_xrpc_error($missing_delete);
}

if (!same_hash($server{reference}{apply_writes}, $server{perlsky}{apply_writes})) {
  note('reference applyWrites: ' . encode_json($server{reference}{apply_writes}));
  note('perlsky applyWrites: ' . encode_json($server{perlsky}{apply_writes}));
  fail_check('applyWrites matches the official reference PDS semantics');
} else {
  pass('applyWrites matches the official reference PDS semantics');
}

if (!same_hash($server{reference}{apply_writes_missing_delete_error}, $server{perlsky}{apply_writes_missing_delete_error})) {
  note('reference applyWrites missing-delete error: ' . encode_json($server{reference}{apply_writes_missing_delete_error}));
  note('perlsky applyWrites missing-delete error: ' . encode_json($server{perlsky}{apply_writes_missing_delete_error}));
  pass('applyWrites missing-delete error remains a documented intentional divergence from the official runtime');
} else {
  pass('applyWrites missing-delete error matches the official reference PDS semantics');
}

note('Comparing repo write swap preconditions');
for my $name (sort keys %server) {
  my $put_swap_commit = post_json($server{$name}{origin}, 'com.atproto.repo.putRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    swapCommit => 'bafyreifakeheadmismatch',
    record     => {
      '$type'   => 'app.bsky.feed.post',
      text      => "put swapCommit mismatch for $name",
      createdAt => '2026-03-11T00:00:02Z',
    },
  }, auth_header($server{$name}{access}));

  my $put_swap_record = post_json($server{$name}{origin}, 'com.atproto.repo.putRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    swapRecord => 'bafyreifakecidmismatch',
    record     => {
      '$type'   => 'app.bsky.feed.post',
      text      => "put swapRecord mismatch for $name",
      createdAt => '2026-03-11T00:00:03Z',
    },
  }, auth_header($server{$name}{access}));

  my $delete_swap_commit = post_json($server{$name}{origin}, 'com.atproto.repo.deleteRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    swapCommit => 'bafyreifakeheadmismatch',
  }, auth_header($server{$name}{access}));

  my $delete_swap_record = post_json($server{$name}{origin}, 'com.atproto.repo.deleteRecord', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
    rkey       => 'diffpost',
    swapRecord => $server{$name}{record_cid},
  }, auth_header($server{$name}{access}));

  $server{$name}{swap_preconditions} = {
    put_swap_commit => {
      status  => $put_swap_commit->code // 0,
      error   => ($put_swap_commit->json || {})->{error} // q(),
      message => normalize_swap_message(($put_swap_commit->json || {})->{message}),
    },
    put_swap_record => {
      status  => $put_swap_record->code // 0,
      error   => ($put_swap_record->json || {})->{error} // q(),
      message => normalize_swap_message(($put_swap_record->json || {})->{message}),
    },
    delete_swap_commit => {
      status  => $delete_swap_commit->code // 0,
      error   => ($delete_swap_commit->json || {})->{error} // q(),
      message => normalize_swap_message(($delete_swap_commit->json || {})->{message}),
    },
    delete_swap_record => {
      status  => $delete_swap_record->code // 0,
      error   => ($delete_swap_record->json || {})->{error} // q(),
      message => normalize_swap_message(($delete_swap_record->json || {})->{message}),
    },
  };
}

if (!same_hash($server{reference}{swap_preconditions}, $server{perlsky}{swap_preconditions})) {
  note('reference swap preconditions: ' . encode_json($server{reference}{swap_preconditions}));
  note('perlsky swap preconditions: ' . encode_json($server{perlsky}{swap_preconditions}));
  fail_check('repo write swap preconditions match the official reference PDS');
} else {
  pass('repo write swap preconditions match the official reference PDS');
}

note('Comparing moderation takedown behavior');
for my $name (sort keys %server) {
  my $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      takedown => { applied => true },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name repo takedown succeeds");
  next unless $res->is_success;

  my $blocked_login = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $server{$name}{renamed_handle} || $server{$name}{handle},
    password   => 'hunter22',
  });
  my $allowed_login = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier     => $server{$name}{renamed_handle} || $server{$name}{handle},
    password       => 'hunter22',
    allowTakendown => true,
  });

  my $blocked_write = $allowed_login->is_success
    ? post_json($server{$name}{origin}, 'com.atproto.repo.createRecord', {
        repo       => $server{$name}{did},
        collection => 'app.bsky.feed.post',
        rkey       => 'takedown-diff',
        record     => {
          %{$record},
          text => "takedown write validation for $name",
        },
      }, auth_header(($allowed_login->json || {})->{accessJwt}))
    : undef;

  my $blocked_list = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => 'app.bsky.feed.post',
  });

  $server{$name}{repo_takedown} = {
    login_blocked => $blocked_login->is_success ? 0 : 1,
    login_error   => ($blocked_login->json || {})->{error},
    allow_login   => $allowed_login->is_success ? 1 : 0,
    write_blocked => ($blocked_write && !$blocked_write->is_success) ? 1 : 0,
    write_error   => $blocked_write ? (($blocked_write->json || {})->{error}) : undef,
    list_blocked  => $blocked_list->is_success ? 0 : 1,
    list_error    => ($blocked_list->json || {})->{error},
  };

  $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      takedown => { applied => false },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name repo takedown restore succeeds");

  $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.repo.strongRef',
        uri     => $server{$name}{record_uri},
        cid     => $server{$name}{record_cid},
      },
      takedown => { applied => true },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name record takedown succeeds");
  next unless $res->is_success;

  my $record_uri = $server{$name}{record_uri};
  my ($collection, $rkey) = $record_uri =~ m{at://[^/]+/([^/]+)/([^/?#]+)\z};
  my $get_record = get_form($server{$name}{origin}, 'com.atproto.repo.getRecord', {
    repo       => $server{$name}{did},
    collection => $collection,
    rkey       => $rkey,
  });
  my $list_records = get_form($server{$name}{origin}, 'com.atproto.repo.listRecords', {
    repo       => $server{$name}{did},
    collection => $collection,
  });

  my $records = $list_records->is_success ? ($list_records->json->{records} || []) : [];
  my $record_hidden = !(grep { (($_->{uri} // q()) eq $record_uri) } @$records);
  $server{$name}{record_takedown} = {
    get_blocked   => $get_record->is_success ? 0 : 1,
    get_error     => ($get_record->json || {})->{error},
    list_hidden   => $record_hidden ? 1 : 0,
    list_success  => $list_records->is_success ? 1 : 0,
  };

  my $sync_record = get_form($server{$name}{origin}, 'com.atproto.sync.getRecord', {
    did        => $server{$name}{did},
    collection => $collection,
    rkey       => $rkey,
  });
  my $sync_car = $sync_record->is_success ? read_car($sync_record->body // q()) : undef;
  $server{$name}{record_takedown_sync} = {
    proof_ok         => $sync_record->is_success ? 1 : 0,
    proof_is_car     => (($sync_record->headers->content_type // q()) =~ m{application/vnd\.ipld\.car}) ? 1 : 0,
    proof_has_record => (
      $sync_car
      && scalar(grep { $_->{cid}->to_string eq $server{$name}{record_cid} } @{ $sync_car->{blocks} || [] })
    ) ? 1 : 0,
  };

  $res = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.repo.strongRef',
        uri     => $record_uri,
        cid     => $server{$name}{record_cid},
      },
      takedown => { applied => false },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($res->is_success, "$name record takedown restore succeeds");
}

check(
  same_hash($server{reference}{repo_takedown}, $server{perlsky}{repo_takedown}),
  'repo takedown login and write semantics match the official reference PDS',
);

check(
  same_hash($server{reference}{record_takedown}, $server{perlsky}{record_takedown}),
  'record takedown visibility semantics match the official reference PDS',
);

check(
  same_hash($server{reference}{record_takedown_sync}, $server{perlsky}{record_takedown_sync}),
  'record takedown sync proof semantics match the official reference PDS',
);

note('Comparing sync.getRepoStatus status semantics');
for my $name (sort keys %server) {
  my $active = get_form($server{$name}{origin}, 'com.atproto.sync.getRepoStatus', {
    did => $server{$name}{did},
  });
  check($active->is_success, "$name active getRepoStatus succeeds");

  my $deactivate = post_json(
    $server{$name}{origin},
    'com.atproto.server.deactivateAccount',
    {},
    auth_header($server{$name}{access}),
  );
  check($deactivate->is_success, "$name deactivateAccount succeeds for repo status comparison");

  my $deactivated = get_form($server{$name}{origin}, 'com.atproto.sync.getRepoStatus', {
    did => $server{$name}{did},
  });
  check($deactivated->is_success, "$name deactivated getRepoStatus succeeds");

  my $deactivated_session = post_json($server{$name}{origin}, 'com.atproto.server.createSession', {
    identifier => $server{$name}{renamed_handle} || $server{$name}{handle},
    password   => 'hunter22',
  });
  check($deactivated_session->is_success, "$name deactivated createSession succeeds for repo status comparison");

  my $reactivate = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject     => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      deactivated => { applied => false },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($reactivate->is_success, "$name repo reactivation succeeds for repo status comparison");

  my $takedown = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      takedown => { applied => true },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($takedown->is_success, "$name repo takedown succeeds for repo status comparison");

  my $takendown = get_form($server{$name}{origin}, 'com.atproto.sync.getRepoStatus', {
    did => $server{$name}{did},
  });
  check($takendown->is_success, "$name takendown getRepoStatus succeeds");

  my $restore = post_json(
    $server{$name}{origin},
    'com.atproto.admin.updateSubjectStatus',
    {
      subject  => {
        '$type' => 'com.atproto.admin.defs#repoRef',
        did     => $server{$name}{did},
      },
      takedown => { applied => false },
    },
    admin_auth_header($server{$name}{admin_password}),
  );
  check($restore->is_success, "$name repo takedown restore succeeds for repo status comparison");

  $server{$name}{repo_status_surface} = {
    active => {
      ok     => $active->is_success ? 1 : 0,
      active => ($active->json || {})->{active} ? 1 : 0,
      status => ($active->json || {})->{status},
      has_rev => defined(($active->json || {})->{rev}) ? 1 : 0,
    },
    deactivated => {
      ok     => $deactivated->is_success ? 1 : 0,
      active => ($deactivated->json || {})->{active} ? 1 : 0,
      status => ($deactivated->json || {})->{status},
      has_rev => defined(($deactivated->json || {})->{rev}) ? 1 : 0,
    },
    takendown => {
      ok     => $takendown->is_success ? 1 : 0,
      active => ($takendown->json || {})->{active} ? 1 : 0,
      status => ($takendown->json || {})->{status},
      has_rev => defined(($takendown->json || {})->{rev}) ? 1 : 0,
    },
  };
}

