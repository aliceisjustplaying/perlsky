  $server{$name}{list_records} = {
    count               => 0 + @$records,
    has_diffpost        => exists $by_rkey{diffpost} ? 1 : 0,
    diffpost_updated    => (($by_rkey{diffpost}{value}{text} // q()) =~ /^put update validation /) ? 1 : 0,
    has_put_created     => exists $by_rkey{'put-created'} ? 1 : 0,
    put_created_matches => (($by_rkey{'put-created'}{value}{text} // q()) =~ /^put create validation /) ? 1 : 0,
  };
}

