#!/usr/bin/env perl
use v5.34;
use warnings;

use Cwd qw(abs_path);
use File::Path qw(make_path);
use File::Spec;
use FindBin qw($Bin);
use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP qw(decode_json encode_json);
use Mojo::UserAgent;
use POSIX qw(strftime);

my $root = abs_path(File::Spec->catdir($Bin, '..'));
my $tools_dir = File::Spec->catdir($root, 'tools', 'browser-automation');
my $cache_dir = File::Spec->catdir($root, '.cache', 'ms-playwright');
my $default_pair_file = File::Spec->catfile($root, '.cache', 'browser-smoke', 'reusable-pair.json');
my $default_artifacts = File::Spec->catdir($root, 'data', 'browser-smoke', 'latest');

my @default_browser_paths = (
  '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
  '/Applications/Brave Browser.app/Contents/MacOS/Brave Browser',
  '/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge',
);

my $default_browser_executable;
for my $candidate (@default_browser_paths) {
  if (-x $candidate) {
    $default_browser_executable = $candidate;
    last;
  }
}

my %opt = (
  app_url       => $ENV{PERLSKY_BROWSER_APP_URL}    || 'https://bsky.app',
  pds_url       => $ENV{PERLSKY_BROWSER_PDS_URL}    || 'https://perlsky.mosphere.at',
  handle        => $ENV{PERLSKY_BROWSER_HANDLE},
  password      => $ENV{PERLSKY_BROWSER_PASSWORD},
  secondary_handle   => $ENV{PERLSKY_BROWSER_SECONDARY_HANDLE},
  secondary_password => $ENV{PERLSKY_BROWSER_SECONDARY_PASSWORD},
  secondary_email    => $ENV{PERLSKY_BROWSER_SECONDARY_EMAIL},
  target_handle => $ENV{PERLSKY_BROWSER_TARGET_HANDLE} || 'alice.mosphere.at',
  artifacts_dir => $ENV{PERLSKY_BROWSER_ARTIFACTS} || $default_artifacts,
  birthdate     => $ENV{PERLSKY_BROWSER_BIRTHDATE} || '1990-01-01',
  secondary_birthdate => $ENV{PERLSKY_BROWSER_SECONDARY_BIRTHDATE} || '1990-01-01',
  public_api_url => $ENV{PERLSKY_BROWSER_PUBLIC_API_URL} || 'https://public.api.bsky.app',
  public_check_timeout_ms => $ENV{PERLSKY_BROWSER_PUBLIC_CHECK_TIMEOUT_MS} || 180_000,
  post_text     => $ENV{PERLSKY_BROWSER_POST_TEXT},
  quote_text    => $ENV{PERLSKY_BROWSER_QUOTE_TEXT},
  reply_text    => $ENV{PERLSKY_BROWSER_REPLY_TEXT},
  profile_note  => $ENV{PERLSKY_BROWSER_PROFILE_NOTE},
  secondary_post_text => $ENV{PERLSKY_BROWSER_SECONDARY_POST_TEXT},
  secondary_quote_text => $ENV{PERLSKY_BROWSER_SECONDARY_QUOTE_TEXT},
  secondary_reply_text => $ENV{PERLSKY_BROWSER_SECONDARY_REPLY_TEXT},
  secondary_profile_note => $ENV{PERLSKY_BROWSER_SECONDARY_PROFILE_NOTE},
  pair_file     => $ENV{PERLSKY_BROWSER_PAIR_FILE} || $default_pair_file,
  headful       => $ENV{PERLSKY_BROWSER_HEADFUL} ? 1 : 0,
  edit_profile  => $ENV{PERLSKY_BROWSER_EDIT_PROFILE} ? 1 : 0,
  public_checks => $ENV{PERLSKY_BROWSER_SKIP_PUBLIC_CHECKS} ? 0 : 1,
  strict_errors => $ENV{PERLSKY_BROWSER_STRICT_ERRORS} ? 1 : 0,
  load_pair     => exists $ENV{PERLSKY_BROWSER_LOAD_PAIR} ? _env_bool($ENV{PERLSKY_BROWSER_LOAD_PAIR}) : 1,
  save_pair     => exists $ENV{PERLSKY_BROWSER_SAVE_PAIR} ? _env_bool($ENV{PERLSKY_BROWSER_SAVE_PAIR}) : 1,
  browser_executable_path => $ENV{PERLSKY_BROWSER_EXECUTABLE_PATH} || $default_browser_executable,
);

my $cmd = shift(@ARGV) // 'run';

if ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h') {
  print <<'USAGE';
Usage:
  script/perlsky-browser-smoke install
  script/perlsky-browser-smoke bootstrap-secondary [options]
  script/perlsky-browser-smoke bootstrap-pair [options]
  script/perlsky-browser-smoke show-pair [options]
  script/perlsky-browser-smoke clear-pair [options]
  script/perlsky-browser-smoke run [options]
  script/perlsky-browser-smoke run-dual [options]
  script/perlsky-browser-smoke run-dual-bootstrap [options]
  script/perlsky-browser-smoke run-pair-bootstrap [options]

Options:
  --handle HANDLE
  --password PASSWORD
  --secondary-handle HANDLE
  --secondary-password PASSWORD
  --secondary-email EMAIL
  --target-handle HANDLE
  --app-url URL
  --pds-url URL
  --artifacts-dir DIR
  --birthdate YYYY-MM-DD
  --secondary-birthdate YYYY-MM-DD
  --public-api-url URL
  --public-check-timeout-ms MS
  --browser-executable-path PATH
  --post-text TEXT
  --quote-text TEXT
  --reply-text TEXT
  --profile-note TEXT
  --secondary-post-text TEXT
  --secondary-quote-text TEXT
  --secondary-reply-text TEXT
  --secondary-profile-note TEXT
  --pair-file PATH
  --load-pair
  --save-pair
  --headful
  --edit-profile
  --public-checks
  --strict-errors

Environment:
  PERLSKY_BROWSER_HANDLE
  PERLSKY_BROWSER_PASSWORD
  PERLSKY_BROWSER_SECONDARY_HANDLE
  PERLSKY_BROWSER_SECONDARY_PASSWORD
  PERLSKY_BROWSER_SECONDARY_EMAIL
  PERLSKY_BROWSER_TARGET_HANDLE
  PERLSKY_BROWSER_APP_URL
  PERLSKY_BROWSER_PDS_URL
  PERLSKY_BROWSER_ARTIFACTS
  PERLSKY_BROWSER_BIRTHDATE
  PERLSKY_BROWSER_SECONDARY_BIRTHDATE
  PERLSKY_BROWSER_PUBLIC_API_URL
  PERLSKY_BROWSER_PUBLIC_CHECK_TIMEOUT_MS
  PERLSKY_BROWSER_EXECUTABLE_PATH
  PERLSKY_BROWSER_POST_TEXT
  PERLSKY_BROWSER_QUOTE_TEXT
  PERLSKY_BROWSER_REPLY_TEXT
  PERLSKY_BROWSER_PROFILE_NOTE
  PERLSKY_BROWSER_SECONDARY_POST_TEXT
  PERLSKY_BROWSER_SECONDARY_QUOTE_TEXT
  PERLSKY_BROWSER_SECONDARY_REPLY_TEXT
  PERLSKY_BROWSER_SECONDARY_PROFILE_NOTE
  PERLSKY_BROWSER_PAIR_FILE
  PERLSKY_BROWSER_LOAD_PAIR=1
  PERLSKY_BROWSER_SAVE_PAIR=1
  PERLSKY_BROWSER_HEADFUL=1
  PERLSKY_BROWSER_EDIT_PROFILE=1
  PERLSKY_BROWSER_SKIP_PUBLIC_CHECKS=1
  PERLSKY_BROWSER_STRICT_ERRORS=1
USAGE
  exit 0;
}

GetOptionsFromArray(
  \@ARGV,
  'handle=s'        => \$opt{handle},
  'password=s'      => \$opt{password},
  'secondary-handle=s' => \$opt{secondary_handle},
  'secondary-password=s' => \$opt{secondary_password},
  'secondary-email=s' => \$opt{secondary_email},
  'target-handle=s' => \$opt{target_handle},
  'app-url=s'       => \$opt{app_url},
  'pds-url=s'       => \$opt{pds_url},
  'artifacts-dir=s' => \$opt{artifacts_dir},
  'birthdate=s'     => \$opt{birthdate},
  'secondary-birthdate=s' => \$opt{secondary_birthdate},
  'public-api-url=s' => \$opt{public_api_url},
  'public-check-timeout-ms=i' => \$opt{public_check_timeout_ms},
  'browser-executable-path=s' => \$opt{browser_executable_path},
  'post-text=s'     => \$opt{post_text},
  'quote-text=s'    => \$opt{quote_text},
  'reply-text=s'    => \$opt{reply_text},
  'profile-note=s'  => \$opt{profile_note},
  'secondary-post-text=s' => \$opt{secondary_post_text},
  'secondary-quote-text=s' => \$opt{secondary_quote_text},
  'secondary-reply-text=s' => \$opt{secondary_reply_text},
  'secondary-profile-note=s' => \$opt{secondary_profile_note},
  'pair-file=s'     => \$opt{pair_file},
  'load-pair!'      => \$opt{load_pair},
  'save-pair!'      => \$opt{save_pair},
  'headful!'        => \$opt{headful},
  'edit-profile!'   => \$opt{edit_profile},
  'public-checks!'  => \$opt{public_checks},
  'strict-errors!'  => \$opt{strict_errors},
) or die "invalid options\n";

if ($cmd eq 'show-pair') {
  my $pair = _load_pair_file($opt{pair_file})
    or die "no reusable pair saved at $opt{pair_file}\n";
  print encode_json($pair), "\n";
  exit 0;
}

if ($cmd eq 'clear-pair') {
  if (-f $opt{pair_file}) {
    unlink $opt{pair_file} or die "unable to remove $opt{pair_file}: $!";
  }
  exit 0;
}

_load_saved_pair(\%opt, $cmd);

if ($cmd eq 'install') {
  install_runtime();
  exit 0;
}

die "--handle is required\n"   unless defined $opt{handle}   && length $opt{handle};
die "--password is required\n" unless defined $opt{password} && length $opt{password};

install_runtime();

my $run_id = strftime('%Y%m%d-%H%M%S', gmtime);
my $artifacts_dir = $opt{artifacts_dir};
make_path($artifacts_dir);

$opt{post_text}    //= "perlsky browser smoke post $run_id";
$opt{quote_text}   //= "perlsky browser smoke quote $run_id";
$opt{reply_text}   //= "perlsky browser smoke reply $run_id";
$opt{profile_note} //= "perlsky browser smoke profile edit $run_id";
$opt{secondary_post_text}    //= "perlsky browser secondary post $run_id";
$opt{secondary_quote_text}   //= "perlsky browser secondary quote $run_id";
$opt{secondary_reply_text}   //= "perlsky browser secondary reply $run_id";
$opt{secondary_profile_note} //= "perlsky browser secondary profile edit $run_id";

my ($pds_host) = $opt{pds_url} =~ m{\Ahttps?://([^/]+)};
$pds_host //= $opt{pds_url};

if ($cmd eq 'bootstrap-secondary') {
  $opt{secondary_handle} //= "smokee2eb$run_id";
  $opt{secondary_handle} =~ s/[^a-z0-9-]//g;
  $opt{secondary_password} //= 'E2e-2026-03-11';
  $opt{secondary_email} //= sprintf('%s@example.com', $opt{secondary_handle});
  my $account = bootstrap_secondary(\%opt);
  print encode_json($account), "\n";
  exit 0;
}

if ($cmd eq 'bootstrap-pair') {
  my ($primary_account, $secondary_account) = bootstrap_pair(\%opt, $run_id);
  _save_pair_file($opt{pair_file}, {
    primary   => $primary_account,
    secondary => $secondary_account,
  }) if $opt{save_pair};
  print encode_json({
    primary   => $primary_account,
    secondary => $secondary_account,
  }), "\n";
  exit 0;
}

my $config = {
  appUrl       => $opt{app_url},
  pdsUrl       => $opt{pds_url},
  pdsHost      => $pds_host,
  targetHandle => $opt{target_handle},
  artifactsDir => $artifacts_dir,
  publicApiUrl => $opt{public_api_url},
  publicCheckTimeoutMs => 0 + $opt{public_check_timeout_ms},
  publicChecks => $opt{public_checks} ? JSON::PP::true : JSON::PP::false,
  strictErrors => $opt{strict_errors} ? JSON::PP::true : JSON::PP::false,
  browserExecutablePath => $opt{browser_executable_path},
  headless     => $opt{headful} ? JSON::PP::false : JSON::PP::true,
};

if ($cmd eq 'run-dual-bootstrap') {
  $opt{secondary_handle} //= "smokee2eb$run_id";
  $opt{secondary_handle} =~ s/[^a-z0-9-]//g;
  $opt{secondary_password} //= 'E2e-2026-03-11';
  $opt{secondary_email} //= sprintf('%s@example.com', $opt{secondary_handle});
  my $account = bootstrap_secondary(\%opt);
  $opt{secondary_handle}   = $account->{handle};
  $opt{secondary_password} = $account->{password};
  $opt{secondary_email}    = $account->{email};
  my $secondary_path = File::Spec->catfile($artifacts_dir, 'secondary-account.json');
  open(my $fh, '>:raw', $secondary_path) or die "unable to write $secondary_path: $!";
  print {$fh} encode_json($account);
  close $fh;
  $config->{secondaryAccount} = $account;
  $cmd = 'run-dual';
}

if ($cmd eq 'run-pair-bootstrap') {
  my ($primary_account, $secondary_account) = bootstrap_pair(\%opt, $run_id);
  $opt{handle}              = $primary_account->{handle};
  $opt{password}            = $primary_account->{password};
  $opt{secondary_handle}    = $secondary_account->{handle};
  $opt{secondary_password}  = $secondary_account->{password};
  my $primary_path = File::Spec->catfile($artifacts_dir, 'primary-account.json');
  open(my $pfh, '>:raw', $primary_path) or die "unable to write $primary_path: $!";
  print {$pfh} encode_json($primary_account);
  close $pfh;
  my $secondary_path = File::Spec->catfile($artifacts_dir, 'secondary-account.json');
  open(my $sfh, '>:raw', $secondary_path) or die "unable to write $secondary_path: $!";
  print {$sfh} encode_json($secondary_account);
  close $sfh;
  $config->{primaryAccount} = $primary_account;
  $config->{secondaryAccount} = $secondary_account;
  $cmd = 'run-dual';
}

if ($cmd eq 'run-dual') {
  die "--secondary-handle is required for run-dual\n"
    unless defined $opt{secondary_handle} && length $opt{secondary_handle};
  die "--secondary-password is required for run-dual\n"
    unless defined $opt{secondary_password} && length $opt{secondary_password};
  $config->{primary} = {
    handle      => $opt{handle},
    password    => $opt{password},
    birthdate   => $opt{birthdate},
    postText    => $opt{post_text},
    quoteText   => $opt{quote_text},
    replyText   => $opt{reply_text},
    profileNote => $opt{profile_note},
    cleanupPostPrefixes => ['perlsky browser smoke '],
  };
  $config->{secondary} = {
    handle      => $opt{secondary_handle},
    password    => $opt{secondary_password},
    birthdate   => $opt{secondary_birthdate},
    postText    => $opt{secondary_post_text},
    quoteText   => $opt{secondary_quote_text},
    replyText   => $opt{secondary_reply_text},
    profileNote => $opt{secondary_profile_note},
    cleanupPostPrefixes => ['perlsky browser secondary '],
  };
  $config->{accountSource} = $opt{_pair_loaded} ? 'pair-file' : 'cli';
  $config->{adapter} = 'perlsky';
  _save_pair_file($opt{pair_file}, {
    primary => {
      handle   => $opt{handle},
      password => $opt{password},
    },
    secondary => {
      handle   => $opt{secondary_handle},
      password => $opt{secondary_password},
      (defined $opt{secondary_email} ? (email => $opt{secondary_email}) : ()),
    },
  }) if $opt{save_pair};
} else {
  $config->{handle}      = $opt{handle};
  $config->{password}    = $opt{password};
  $config->{birthdate}   = $opt{birthdate};
  $config->{postText}    = $opt{post_text};
  $config->{quoteText}   = $opt{quote_text};
  $config->{replyText}   = $opt{reply_text};
  $config->{profileNote} = $opt{profile_note};
  $config->{editProfile} = $opt{edit_profile} ? JSON::PP::true : JSON::PP::false;
  $config->{adapter}     = 'perlsky';
}

my $config_path = File::Spec->catfile($artifacts_dir, 'config.json');
open(my $cfg, '>:raw', $config_path) or die "unable to write $config_path: $!";
print {$cfg} encode_json($config);
close $cfg;

local $ENV{PLAYWRIGHT_BROWSERS_PATH} = $cache_dir;
my $script = File::Spec->catfile($tools_dir, $cmd eq 'run-dual' ? 'dual-smoke.mjs' : 'smoke.mjs');
my @cmdline = ('node', $script, $config_path);
system(@cmdline) == 0 or die "browser smoke failed\n";

sub install_runtime {
  make_path($cache_dir);
  run_or_die('npm', 'install', '--prefix', $tools_dir);
  local $ENV{PLAYWRIGHT_BROWSERS_PATH} = $cache_dir;
  run_or_die('npm', 'exec', '--prefix', $tools_dir, 'playwright', '--', 'install', 'chromium');
}

sub run_or_die {
  my @cmdline = @_;
  system(@cmdline) == 0 or die "command failed: @cmdline\n";
}

sub bootstrap_secondary {
  my ($opt) = @_;
  return _bootstrap_account(
    $opt,
    handle   => $opt->{secondary_handle},
    email    => $opt->{secondary_email},
    password => $opt->{secondary_password},
  );
}

sub bootstrap_pair {
  my ($opt, $run_id) = @_;
  my $primary_handle = "smokee2ea$run_id";
  my $secondary_handle = "smokee2eb$run_id";
  $primary_handle =~ s/[^a-z0-9-]//g;
  $secondary_handle =~ s/[^a-z0-9-]//g;
  my $password = 'E2e-2026-03-11';
  my $primary_account = _bootstrap_account(
    $opt,
    handle   => $primary_handle,
    email    => sprintf('%s@example.com', $primary_handle),
    password => $password,
  );
  my $secondary_account = _bootstrap_account(
    $opt,
    handle   => $secondary_handle,
    email    => sprintf('%s@example.com', $secondary_handle),
    password => $password,
  );
  return ($primary_account, $secondary_account);
}

sub _load_saved_pair {
  my ($opt, $cmd) = @_;
  return unless $opt->{load_pair};
  return if $cmd eq 'bootstrap-secondary' || $cmd eq 'bootstrap-pair' || $cmd eq 'run-dual-bootstrap' || $cmd eq 'run-pair-bootstrap';

  my $pair = _load_pair_file($opt->{pair_file}) or return;
  if ($cmd eq 'run-dual') {
    $opt->{handle}             //= $pair->{primary}{handle};
    $opt->{password}           //= $pair->{primary}{password};
    $opt->{secondary_handle}   //= $pair->{secondary}{handle};
    $opt->{secondary_password} //= $pair->{secondary}{password};
    $opt->{secondary_email}    //= $pair->{secondary}{email};
    $opt->{_pair_loaded} = 1;
    return;
  }

  if ($cmd eq 'run') {
    $opt->{handle}   //= $pair->{primary}{handle};
    $opt->{password} //= $pair->{primary}{password};
    $opt->{_pair_loaded} = 1;
  }
}

sub _load_pair_file {
  my ($path) = @_;
  return unless defined $path && length $path && -f $path;
  open(my $fh, '<:raw', $path) or die "unable to read $path: $!";
  local $/ = undef;
  my $json = <$fh>;
  close $fh;
  my $pair = decode_json($json);
  return unless ref($pair) eq 'HASH'
    && ref($pair->{primary}) eq 'HASH'
    && ref($pair->{secondary}) eq 'HASH';
  return $pair;
}

sub _save_pair_file {
  my ($path, $pair) = @_;
  return unless defined $path && length $path;
  my ($volume, $directories) = File::Spec->splitpath($path);
  my $dir = File::Spec->catpath($volume, $directories, q());
  make_path($dir) if length $dir && !-d $dir;
  my $payload = {
    version  => 1,
    saved_at => time,
    primary  => $pair->{primary},
    secondary => $pair->{secondary},
  };
  open(my $fh, '>:raw', $path) or die "unable to write $path: $!";
  print {$fh} encode_json($payload);
  close $fh;
}

sub _env_bool {
  my ($value) = @_;
  return 0 unless defined $value;
  return 0 if $value =~ /\A(?:0|false|no|off)\z/i;
  return 1;
}

sub _bootstrap_account {
  my ($opt, %args) = @_;
  my $ua = Mojo::UserAgent->new;
  my $base = $opt->{pds_url};
  $base =~ s{/\z}{};
  my $session_tx = $ua->post(
    "$base/xrpc/com.atproto.server.createSession" => {
      'content-type' => 'application/json',
    } => json => {
      identifier => $opt->{handle},
      password   => $opt->{password},
    }
  );
  die _tx_error($session_tx, 'createSession for primary smoke account failed')
    unless $session_tx->result->is_success;
  my $access_jwt = $session_tx->result->json->{accessJwt}
    or die "primary createSession response missing accessJwt\n";

  my $invite_tx = $ua->post(
    "$base/xrpc/com.atproto.server.createInviteCode" => {
      'content-type'  => 'application/json',
      authorization   => "Bearer $access_jwt",
    } => json => {
      useCount => 1,
    }
  );
  die _tx_error($invite_tx, 'createInviteCode failed')
    unless $invite_tx->result->is_success;
  my $invite = $invite_tx->result->json->{code}
    or die "createInviteCode response missing code\n";

  my $account_tx = $ua->post(
    "$base/xrpc/com.atproto.server.createAccount" => {
      'content-type' => 'application/json',
    } => json => {
      handle     => $args{handle},
      email      => $args{email},
      password   => $args{password},
      inviteCode => $invite,
    }
  );
  die _tx_error($account_tx, "createAccount failed for $args{handle}")
    unless $account_tx->result->is_success;
  my $json = $account_tx->result->json;
  return {
    inviteCode => $invite,
    handle     => $json->{handle},
    did        => $json->{did},
    email      => $json->{email},
    password   => $args{password},
  };
}

sub _tx_error {
  my ($tx, $prefix) = @_;
  my $res = $tx->result;
  my $body = $res ? ($res->body // q()) : q();
  return "$prefix: " . ($res ? $res->code : 'no-response') . " $body\n";
}
